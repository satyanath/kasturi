// ಅವಿಭಾಜ್ಯ_ಜರಡಿ.kst - ಎರಟೊಸ್ತನೀಸ್‌ನ ಜರಡಿ: N ವರೆಗಿನ ಅವಿಭಾಜ್ಯ ಸಂಖ್ಯೆಗಳು
//
//     kasturi -r examples/ಅವಿಭಾಜ್ಯ_ಜರಡಿ.kst -- 100

ಆಮದು "ಐಒ";
ಆಮದು "ಸಾಮಾನ್ಯ";

ಕ್ರಿಯೆ ಮುಖ್ಯ(ಸಂಖ್ಯೆ ಎಷ್ಟು, ಪದ* ಚರಾಂಶಗಳು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ಸಂಖ್ಯೆ ಮಿತಿ = 100;
    (ಎಷ್ಟು > 1) ಆದರೆ ಮಿತಿ = ಪದದಿಂದ_ಸಂಖ್ಯೆ(ಚರಾಂಶಗಳು[1]);
    (ಮಿತಿ < 2) ಆದರೆ {
        ಸಾಲುಮುದ್ರಿಸು("ಮಿತಿ ಕನಿಷ್ಠ 2 ಆಗಿರಬೇಕು");
        ಮರಳಿ 1;
    }

    ತಾರ್ಕಿಕ* ಸಂಯುಕ್ತ = ಸೊನ್ನೆ_ಸ್ಮರಣೆ(ಮಿತಿ + 1, ಗಾತ್ರ(ತಾರ್ಕಿಕ));
    ಎಣಿಕೆ (ದೀರ್ಘ ಇ = 2; ಇ * ಇ <= ಮಿತಿ; ಇ++) {
        (ಅಲ್ಲ ಸಂಯುಕ್ತ[ಇ]) ಆದರೆ {
            ಎಣಿಕೆ (ದೀರ್ಘ ಜ = ಇ * ಇ; ಜ <= ಮಿತಿ; ಜ += ಇ) ಸಂಯುಕ್ತ[ಜ] = ಸತ್ಯ;
        }
    }

    ಸಂಖ್ಯೆ ಎಣಿಕೆ_ಸಂ = 0;
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 2; ಇ <= ಮಿತಿ; ಇ++) {
        (ಅಲ್ಲ ಸಂಯುಕ್ತ[ಇ]) ಆದರೆ {
            ರೂಪಮುದ್ರಣ("%~6d", ಇ);
            ಎಣಿಕೆ_ಸಂ++;
            (ಎಣಿಕೆ_ಸಂ % 10 == 0) ಆದರೆ ರೂಪಮುದ್ರಣ("\n");
        }
    }
    (ಎಣಿಕೆ_ಸಂ % 10 != 0) ಆದರೆ ರೂಪಮುದ್ರಣ("\n");
    ರೂಪಮುದ್ರಣ("\n%~d ರವರೆಗೆ %~d ಅವಿಭಾಜ್ಯ ಸಂಖ್ಯೆಗಳಿವೆ.\n", ಮಿತಿ, ಎಣಿಕೆ_ಸಂ);
    ಸ್ಮರಣೆ_ಬಿಡು(ಸಂಯುಕ್ತ);
    ಮರಳಿ 0;
}
