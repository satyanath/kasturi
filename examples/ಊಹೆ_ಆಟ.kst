// ಊಹೆ_ಆಟ.kst - ಸಂಖ್ಯೆ ಊಹಿಸುವ ಆಟ
//
//     kasturi -r examples/ಊಹೆ_ಆಟ.kst
//
// ಕನ್ನಡ ಅಂಕಿಗಳಲ್ಲೂ (೪೨) ಉತ್ತರಿಸಬಹುದು.

ಆಮದು "ಸಾಮಾನ್ಯ";

ಕ್ರಿಯೆ ಮುಖ್ಯ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ಯಾದೃಚ್ಛಿಕ_ಬೀಜ(ಪ್ರಸ್ತುತ_ಸಮಯ());
    ಸಂಖ್ಯೆ ಗುಟ್ಟು = ಯಾದೃಚ್ಛಿಕ_ವ್ಯಾಪ್ತಿ(1, 100);
    ಸಂಖ್ಯೆ ಪ್ರಯತ್ನಗಳು = 0;
    ಸಂಖ್ಯೆ ಊಹೆ = 0;

    ಸಾಲುಮುದ್ರಿಸು("ನಾನು 1 ರಿಂದ 100 ರ ನಡುವಿನ ಒಂದು ಸಂಖ್ಯೆಯನ್ನು ಯೋಚಿಸಿದ್ದೇನೆ.");
    (ಊಹೆ != ಗುಟ್ಟು) ಸಮಯವರೆಗೆ {
        ಮುದ್ರಿಸು("ನಿಮ್ಮ ಊಹೆ: ");
        ಓದು(ಊಹೆ);
        ಪ್ರಯತ್ನಗಳು++;
        (ಊಹೆ < ಗುಟ್ಟು) ಆದರೆ ಸಾಲುಮುದ್ರಿಸು("ಇನ್ನೂ ದೊಡ್ಡದು!");
        ಇಲ್ಲವಾದರೆ (ಊಹೆ > ಗುಟ್ಟು) ಆದರೆ ಸಾಲುಮುದ್ರಿಸು("ಇನ್ನೂ ಸಣ್ಣದು!");
        (ಪ್ರಯತ್ನಗಳು >= 20) ಆದರೆ {
            ಸಾಲುಮುದ್ರಿಸು("ಸಾಕು! ಸಂಖ್ಯೆ ", ಗುಟ್ಟು, " ಆಗಿತ್ತು.");
            ಮರಳಿ 1;
        }
    }
    ಸಾಲುಮುದ್ರಿಸು("ಸರಿ! ", ಪ್ರಯತ್ನಗಳು, " ಪ್ರಯತ್ನಗಳಲ್ಲಿ ಊಹಿಸಿದಿರಿ.");
    ಮರಳಿ 0;
}
