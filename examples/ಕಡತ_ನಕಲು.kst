// ಕಡತ_ನಕಲು.kst - ಒಂದು ಕಡತವನ್ನು ಇನ್ನೊಂದಕ್ಕೆ ನಕಲಿಸುತ್ತದೆ (Unix 'cp' ತರಹ)
//
//     kasturi examples/ಕಡತ_ನಕಲು.kst
//     ಕಡತ_ನಕಲು ಮೂಲ.txt ಗುರಿ.txt

ಆಮದು "ಐಒ";

ಸ್ಥಿರ ಸಂಖ್ಯೆ ತುಣುಕು = 65536;

ಕ್ರಿಯೆ ಮುಖ್ಯ(ಸಂಖ್ಯೆ ಎಷ್ಟು, ಪದ* ಚರಾಂಶಗಳು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    (ಎಷ್ಟು != 3) ಆದರೆ {
        ಕಡತ_ರೂಪಮುದ್ರಣ(ದೋಷಹರಿವು, "ಬಳಕೆ: %s <ಮೂಲ> <ಗುರಿ>\n", ಚರಾಂಶಗಳು[0]);
        ಮರಳಿ 2;
    }
    ಕಡತ* ಮೂಲ = ಕಡತ_ತೆರೆ(ಚರಾಂಶಗಳು[1], "rb");
    (ಮೂಲ == ಖಾಲಿ) ಆದರೆ {
        ದೋಷ_ಮುದ್ರಿಸು(ಚರಾಂಶಗಳು[1]);
        ಮರಳಿ 1;
    }
    ಕಡತ* ಗುರಿ = ಕಡತ_ತೆರೆ(ಚರಾಂಶಗಳು[2], "wb");
    (ಗುರಿ == ಖಾಲಿ) ಆದರೆ {
        ದೋಷ_ಮುದ್ರಿಸು(ಚರಾಂಶಗಳು[2]);
        ಕಡತ_ಮುಚ್ಚು(ಮೂಲ);
        ಮರಳಿ 1;
    }
    ಅಕ್ಷರ ಬಫರ್[ತುಣುಕು];
    ದೀರ್ಘ ಒಟ್ಟು = 0;
    (ಸತ್ಯ) ಸಮಯವರೆಗೆ {
        ದೀರ್ಘ ಓದಿದ = ಕಡತ_ಓದು(ಬಫರ್, 1, ತುಣುಕು, ಮೂಲ);
        (ಓದಿದ <= 0) ಆದರೆ ನಿಲ್ಲಿಸು;
        (ಕಡತ_ಬರೆ(ಬಫರ್, 1, ಓದಿದ, ಗುರಿ) != ಓದಿದ) ಆದರೆ {
            ದೋಷ_ಮುದ್ರಿಸು("ಬರೆಯುವಲ್ಲಿ ದೋಷ");
            ಮರಳಿ 1;
        }
        ಒಟ್ಟು += ಓದಿದ;
    }
    ಸಂಖ್ಯೆ ದೋಷ = ದೋಷವೇ(ಮೂಲ);
    ಕಡತ_ಮುಚ್ಚು(ಮೂಲ);
    (ಕಡತ_ಮುಚ್ಚು(ಗುರಿ) != 0 || ದೋಷ != 0) ಆದರೆ {
        ದೋಷ_ಮುದ್ರಿಸು("ನಕಲು ವಿಫಲವಾಯಿತು");
        ಮರಳಿ 1;
    }
    ರೂಪಮುದ್ರಣ("%lld ಬೈಟ್‌ಗಳನ್ನು ನಕಲಿಸಲಾಗಿದೆ (%~lld)\n", ಒಟ್ಟು, ಒಟ್ಟು);
    ಮರಳಿ 0;
}
