// ಪದ_ಎಣಿಕೆ.kst - ಸಾಲು, ಪದ, ಅಕ್ಷರ ಮತ್ತು ಬೈಟ್‌ಗಳನ್ನು ಎಣಿಸುತ್ತದೆ (Unix 'wc' ತರಹ)
//
//     kasturi examples/ಪದ_ಎಣಿಕೆ.kst
//     ಪದ_ಎಣಿಕೆ ಕಡತ1.txt ಕಡತ2.txt
//     ಪದ_ಎಣಿಕೆ < ಕಡತ.txt

ಆಮದು "ಐಒ";

ರಚನೆ ಎಣಿಕೆಗಳು {
    ದೀರ್ಘ ಸಾಲುಗಳು, ಪದಗಳು, ಅಕ್ಷರಗಳು, ಬೈಟ್‌ಗಳು;
};

ಕ್ರಿಯೆ ಎಣಿಸು(ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಎಣಿಕೆಗಳು {
    ಎಣಿಕೆಗಳು ಫ = {0, 0, 0, 0};
    ತಾರ್ಕಿಕ ಪದದೊಳಗೆ = ಅಸತ್ಯ;
    // ಕಸ್ತೂರಿಯಲ್ಲಿ ನಿಗದಿ ಒಂದು ಹೇಳಿಕೆ, ಅಭಿವ್ಯಕ್ತಿಯಲ್ಲ; ಆದ್ದರಿಂದ ಓದಿ ನಂತರ ಪರೀಕ್ಷಿಸುತ್ತೇವೆ
    (ಸತ್ಯ) ಸಮಯವರೆಗೆ {
        ಸಂಖ್ಯೆ ಅ = ಕಡತ_ಅಕ್ಷರಪಡೆ(ಹರಿವು);
        (ಅ == ಕಡತಾಂತ) ಆದರೆ ನಿಲ್ಲಿಸು;
        ಫ.ಬೈಟ್‌ಗಳು++;
        // UTF-8: ಮುಂದುವರಿಕೆ ಬೈಟ್‌ಗಳು (10xxxxxx) ಹೊಸ ಅಕ್ಷರವಲ್ಲ
        ((ಅ & 0xC0) != 0x80) ಆದರೆ ಫ.ಅಕ್ಷರಗಳು++;
        (ಅ == '\n') ಆದರೆ ಫ.ಸಾಲುಗಳು++;
        (ಅ == ' ' || ಅ == '\n' || ಅ == '\t' || ಅ == '\r') ಆದರೆ {
            ಪದದೊಳಗೆ = ಅಸತ್ಯ;
        } ಇಲ್ಲವಾದರೆ (ಅಲ್ಲ ಪದದೊಳಗೆ) ಆದರೆ {
            ಪದದೊಳಗೆ = ಸತ್ಯ;
            ಫ.ಪದಗಳು++;
        }
    }
    ಮರಳಿ ಫ;
}

ಕ್ರಿಯೆ ತೋರಿಸು(ಎಣಿಕೆಗಳು ಎ, ಪದ ಹೆಸರು) {
    ರೂಪಮುದ್ರಣ("%8lld %8lld %8lld %8lld  %s\n", ಎ.ಸಾಲುಗಳು, ಎ.ಪದಗಳು, ಎ.ಅಕ್ಷರಗಳು, ಎ.ಬೈಟ್‌ಗಳು, ಹೆಸರು);
}

ಕ್ರಿಯೆ ಮುಖ್ಯ(ಸಂಖ್ಯೆ ಎಷ್ಟು, ಪದ* ಚರಾಂಶಗಳು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ರೂಪಮುದ್ರಣ("%8s %8s %8s %8s\n", "ಸಾಲು", "ಪದ", "ಅಕ್ಷರ", "ಬೈಟ್");
    (ಎಷ್ಟು < 2) ಆದರೆ {
        ತೋರಿಸು(ಎಣಿಸು(ಒಳಹರಿವು), "");
        ಮರಳಿ 0;
    }
    ಸಂಖ್ಯೆ ಸ್ಥಿತಿ = 0;
    ಎಣಿಕೆಗಳು ಒಟ್ಟು = {0, 0, 0, 0};
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 1; ಇ < ಎಷ್ಟು; ಇ++) {
        ಕಡತ* ಕ = ಕಡತ_ತೆರೆ(ಚರಾಂಶಗಳು[ಇ], "rb");
        (ಕ == ಖಾಲಿ) ಆದರೆ {
            ದೋಷ_ಮುದ್ರಿಸು(ಚರಾಂಶಗಳು[ಇ]);
            ಸ್ಥಿತಿ = 1;
            ಮುಂದುವರಿಸು;
        }
        ಎಣಿಕೆಗಳು ಎ = ಎಣಿಸು(ಕ);
        ಕಡತ_ಮುಚ್ಚು(ಕ);
        ತೋರಿಸು(ಎ, ಚರಾಂಶಗಳು[ಇ]);
        ಒಟ್ಟು.ಸಾಲುಗಳು += ಎ.ಸಾಲುಗಳು;
        ಒಟ್ಟು.ಪದಗಳು += ಎ.ಪದಗಳು;
        ಒಟ್ಟು.ಅಕ್ಷರಗಳು += ಎ.ಅಕ್ಷರಗಳು;
        ಒಟ್ಟು.ಬೈಟ್‌ಗಳು += ಎ.ಬೈಟ್‌ಗಳು;
    }
    (ಎಷ್ಟು > 2) ಆದರೆ ತೋರಿಸು(ಒಟ್ಟು, "ಒಟ್ಟು");
    ಮರಳಿ ಸ್ಥಿತಿ;
}
