// ವಿದ್ಯಾರ್ಥಿಗಳು.kst - ರಚನೆಗಳು, ಸರಣಿಗಳು, ವಿಂಗಡಣೆ ಮತ್ತು ಕಡತಕ್ಕೆ ವರದಿ
//
//     kasturi -r examples/ವಿದ್ಯಾರ್ಥಿಗಳು.kst

ಆಮದು "ಐಒ";
ಆಮದು "ಪದಗಳು";

ಸ್ಥಿರ ಸಂಖ್ಯೆ ವಿಷಯಗಳು = 3;

ರಚನೆ ವಿದ್ಯಾರ್ಥಿ {
    ಪದ ಹೆಸರು;
    ಸಂಖ್ಯೆ ಅಂಕಗಳು[ವಿಷಯಗಳು];
    ದಶಾಂಶ ಸರಾಸರಿ;
};

ಕ್ರಿಯೆ ಸರಾಸರಿ_ಲೆಕ್ಕಿಸು(ವಿದ್ಯಾರ್ಥಿ* ವಿ) {
    ಸಂಖ್ಯೆ ಮೊತ್ತ = 0;
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 0; ಇ < ವಿಷಯಗಳು; ಇ++) ಮೊತ್ತ += ವಿ->ಅಂಕಗಳು[ಇ];
    ವಿ->ಸರಾಸರಿ = (ದಶಾಂಶ) ಮೊತ್ತ / ವಿಷಯಗಳು;
}

ಕ್ರಿಯೆ ಶ್ರೇಣಿ(ದಶಾಂಶ ಸರಾಸರಿ) ಫಲಿತಾಂಶ ಪದ {
    (ಸರಾಸರಿ >= 85) ಆದರೆ ಮರಳಿ "ಅತ್ಯುತ್ತಮ";
    (ಸರಾಸರಿ >= 70) ಆದರೆ ಮರಳಿ "ಉತ್ತಮ";
    (ಸರಾಸರಿ >= 50) ಆದರೆ ಮರಳಿ "ಸಾಧಾರಣ";
    ಮರಳಿ "ಅನುತ್ತೀರ್ಣ";
}

// ಸರಾಸರಿಯ ಇಳಿಕೆ ಕ್ರಮದಲ್ಲಿ ಗುಳ್ಳೆ ವಿಂಗಡಣೆ (bubble sort)
ಕ್ರಿಯೆ ವಿಂಗಡಿಸು(ವಿದ್ಯಾರ್ಥಿ ಪಟ್ಟಿ[], ಸಂಖ್ಯೆ ನ) {
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 0; ಇ < ನ - 1; ಇ++) {
        ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಜ = 0; ಜ < ನ - 1 - ಇ; ಜ++) {
            (ಪಟ್ಟಿ[ಜ].ಸರಾಸರಿ < ಪಟ್ಟಿ[ಜ + 1].ಸರಾಸರಿ) ಆದರೆ {
                ವಿದ್ಯಾರ್ಥಿ ತಾತ್ಕಾಲಿಕ = ಪಟ್ಟಿ[ಜ];
                ಪಟ್ಟಿ[ಜ] = ಪಟ್ಟಿ[ಜ + 1];
                ಪಟ್ಟಿ[ಜ + 1] = ತಾತ್ಕಾಲಿಕ;
            }
        }
    }
}

ಕ್ರಿಯೆ ವರದಿ(ಕಡತ* ಹರಿವು, ವಿದ್ಯಾರ್ಥಿ ಪಟ್ಟಿ[], ಸಂಖ್ಯೆ ನ) {
    ಕಡತ_ರೂಪಮುದ್ರಣ(ಹರಿವು, "%-4s %-12s %6s %6s %6s %8s  %s\n", "ಕ್ರ", "ಹೆಸರು", "ಗಣಿತ", "ವಿಜ್ಞಾನ", "ಕನ್ನಡ", "ಸರಾಸರಿ", "ಶ್ರೇಣಿ");
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 0; ಇ < ನ; ಇ++) {
        ವಿದ್ಯಾರ್ಥಿ* ವಿ = &ಪಟ್ಟಿ[ಇ];
        ಕಡತ_ರೂಪಮುದ್ರಣ(ಹರಿವು, "%~-4d %s", ಇ + 1, ವಿ->ಹೆಸರು);
        // ಕನ್ನಡ ಪದಗಳ ಅಗಲವನ್ನು ಅಕ್ಷರಗಳಲ್ಲಿ ಹೊಂದಿಸು
        ಎಣಿಕೆ (ದೀರ್ಘ ಜ = ಅಕ್ಷರಗಳ_ಸಂಖ್ಯೆ(ವಿ->ಹೆಸರು); ಜ < 13; ಜ++) ಕಡತ_ಅಕ್ಷರಹಾಕು(' ', ಹರಿವು);
        ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಕ = 0; ಕ < ವಿಷಯಗಳು; ಕ++) ಕಡತ_ರೂಪಮುದ್ರಣ(ಹರಿವು, "%6d ", ವಿ->ಅಂಕಗಳು[ಕ]);
        ಕಡತ_ರೂಪಮುದ್ರಣ(ಹರಿವು, "%8.2f  %s\n", ವಿ->ಸರಾಸರಿ, ಶ್ರೇಣಿ(ವಿ->ಸರಾಸರಿ));
    }
}

ಕ್ರಿಯೆ ಮುಖ್ಯ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ವಿದ್ಯಾರ್ಥಿ ವರ್ಗ[] = {
        {"ಅನನ್ಯ", {88, 92, 79}},
        {"ಭರತ್", {45, 60, 52}},
        {"ಚೈತ್ರಾ", {95, 89, 97}},
        {"ದೀಪಕ್", {70, 75, 68}},
        {"ಈಶ್ವರಿ", {30, 41, 49}}
    };
    ಸಂಖ್ಯೆ ನ = ಗಾತ್ರ(ವರ್ಗ) / ಗಾತ್ರ(ವಿದ್ಯಾರ್ಥಿ);
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 0; ಇ < ನ; ಇ++) ಸರಾಸರಿ_ಲೆಕ್ಕಿಸು(&ವರ್ಗ[ಇ]);
    ವಿಂಗಡಿಸು(ವರ್ಗ, ನ);
    ವರದಿ(ಹೊರಹರಿವು, ವರ್ಗ, ನ);

    ಕಡತ* ಕ = ಕಡತ_ತೆರೆ("ವರದಿ.txt", "w");
    (ಕ != ಖಾಲಿ) ಆದರೆ {
        ವರದಿ(ಕ, ವರ್ಗ, ನ);
        ಕಡತ_ಮುಚ್ಚು(ಕ);
        ಸಾಲುಮುದ್ರಿಸು("\nವರದಿಯನ್ನು 'ವರದಿ.txt' ಕಡತಕ್ಕೆ ಬರೆಯಲಾಗಿದೆ.");
    }
    ಮರಳಿ 0;
}
