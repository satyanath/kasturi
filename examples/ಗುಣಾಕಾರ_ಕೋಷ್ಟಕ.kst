// ಗುಣಾಕಾರ_ಕೋಷ್ಟಕ.kst - ಕನ್ನಡ ಅಂಕಿಗಳಲ್ಲಿ ಮಗ್ಗಿ (ಗುಣಾಕಾರ ಕೋಷ್ಟಕ)
//
//     kasturi -r examples/ಗುಣಾಕಾರ_ಕೋಷ್ಟಕ.kst

ಆಮದು "ಐಒ";

ಸ್ಥಿರ ಸಂಖ್ಯೆ ಗರಿಷ್ಠ = 10;

ಕ್ರಿಯೆ ಮುಖ್ಯ() {
    ರೂಪಮುದ್ರಣ("    |");
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಕಾ = 1; ಕಾ <= ಗರಿಷ್ಠ; ಕಾ++) ರೂಪಮುದ್ರಣ("%~4d", ಕಾ);
    ರೂಪಮುದ್ರಣ("\n----+");
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಕಾ = 1; ಕಾ <= ಗರಿಷ್ಠ; ಕಾ++) ರೂಪಮುದ್ರಣ("----");
    ರೂಪಮುದ್ರಣ("\n");
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಸಾ = 1; ಸಾ <= ಗರಿಷ್ಠ; ಸಾ++) {
        ರೂಪಮುದ್ರಣ("%~3d |", ಸಾ);
        ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಕಾ = 1; ಕಾ <= ಗರಿಷ್ಠ; ಕಾ++) ರೂಪಮುದ್ರಣ("%~4d", ಸಾ * ಕಾ);
        ರೂಪಮುದ್ರಣ("\n");
    }
}
