// ಐಒ.kst - ಕಸ್ತೂರಿ ಪ್ರಮಾಣಿತ ಒಳಹರಿವು / ಹೊರಹರಿವು ಗ್ರಂಥಾಲಯ
//
// C ಭಾಷೆಯ <stdio.h> ಗೆ ಸಮಾನ. ಎಲ್ಲ ಕ್ರಿಯೆಗಳ ಅನುಷ್ಠಾನ runtime/ ಕೋಶದಲ್ಲಿದೆ
// (kst_stdio.c, kst_printf.c, kst_scanf.c). ಬಳಕೆ:
//
//     ಆಮದು "ಐಒ";
//
// ಎಲ್ಲ ಪದಗಳು UTF-8 ಸಂಕೇತೀಕರಣದಲ್ಲಿವೆ. ರೂಪ (format) ಪದಗಳಲ್ಲಿ '~' ಧ್ವಜ
// ಸಂಖ್ಯೆಗಳನ್ನು ಕನ್ನಡ ಅಂಕಿಗಳಲ್ಲಿ ಮುದ್ರಿಸುತ್ತದೆ: ರೂಪಮುದ್ರಣ("%~d", 25) -> ೨೫

// ---------------------------------------------------------------
// ಪ್ರಕಾರಗಳು
// ---------------------------------------------------------------

ರಚನೆ ಕಡತ;                          // FILE (ಅಪಾರದರ್ಶಕ)
ರಚನೆ ಕಡತಸ್ಥಾನ { ದೀರ್ಘ ಸ್ಥಾನ; };    // fpos_t

// ---------------------------------------------------------------
// ಪ್ರಮಾಣಿತ ಹರಿವುಗಳು
// ---------------------------------------------------------------

ಬಾಹ್ಯ "kst_stdin" ಕಡತ* ಒಳಹರಿವು;     // stdin
ಬಾಹ್ಯ "kst_stdout" ಕಡತ* ಹೊರಹರಿವು;   // stdout
ಬಾಹ್ಯ "kst_stderr" ಕಡತ* ದೋಷಹರಿವು;   // stderr

// ---------------------------------------------------------------
// ಸ್ಥಿರಾಂಕಗಳು
// ---------------------------------------------------------------

ಸ್ಥಿರ ಸಂಖ್ಯೆ ಕಡತಾಂತ = -1;                 // EOF
ಸ್ಥಿರ ಸಂಖ್ಯೆ ಬಫರ್_ಅಳತೆ = 4096;            // BUFSIZ
ಸ್ಥಿರ ಸಂಖ್ಯೆ ಕಡತಹೆಸರು_ಗರಿಷ್ಠ = 4096;      // FILENAME_MAX
ಸ್ಥಿರ ಸಂಖ್ಯೆ ತೆರೆದ_ಕಡತ_ಗರಿಷ್ಠ = 1024;     // FOPEN_MAX
ಸ್ಥಿರ ಸಂಖ್ಯೆ ತಾತ್ಕಾಲಿಕ_ಗರಿಷ್ಠ = 238328;    // TMP_MAX
ಸ್ಥಿರ ಸಂಖ್ಯೆ ತಾತ್ಕಾಲಿಕಹೆಸರು_ಉದ್ದ = 4096;   // L_tmpnam

ಸ್ಥಿರ ಸಂಖ್ಯೆ ಆರಂಭದಿಂದ = 0;     // SEEK_SET
ಸ್ಥಿರ ಸಂಖ್ಯೆ ಪ್ರಸ್ತುತದಿಂದ = 1;   // SEEK_CUR
ಸ್ಥಿರ ಸಂಖ್ಯೆ ಕೊನೆಯಿಂದ = 2;     // SEEK_END

ಸ್ಥಿರ ಸಂಖ್ಯೆ ಪೂರ್ಣ_ಬಫರ್ = 0;    // _IOFBF
ಸ್ಥಿರ ಸಂಖ್ಯೆ ಸಾಲು_ಬಫರ್ = 1;     // _IOLBF
ಸ್ಥಿರ ಸಂಖ್ಯೆ ಬಫರ್_ಇಲ್ಲ = 2;     // _IONBF

// ದೋಷ ಸಂಖ್ಯೆಗಳು (ದೋಷಸಂಖ್ಯೆ() ಹಿಂದಿರುಗಿಸುವ ಮೌಲ್ಯಗಳು)
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಇಲ್ಲ = 0;
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಅನುಮತಿಯಿಲ್ಲ = 1;      // EPERM
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಕಡತವಿಲ್ಲ = 2;         // ENOENT
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಒಹ = 5;               // EIO
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಅಮಾನ್ಯ_ಹರಿವು = 9;     // EBADF
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಸ್ಮರಣೆ = 12;          // ENOMEM
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಪ್ರವೇಶ = 13;          // EACCES
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಈಗಾಗಲೇ_ಇದೆ = 17;     // EEXIST
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಕೋಶವಲ್ಲ = 20;        // ENOTDIR
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಕೋಶ = 21;            // EISDIR
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಅಮಾನ್ಯ = 22;          // EINVAL
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಹಲವು_ಕಡತಗಳು = 24;    // EMFILE
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಸ್ಥಳವಿಲ್ಲ = 28;       // ENOSPC
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಸ್ಥಾನ = 29;           // ESPIPE
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ವ್ಯಾಪ್ತಿ = 34;         // ERANGE
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಉದ್ದ_ಹೆಸರು = 36;      // ENAMETOOLONG
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಅಧಿಕ = 75;           // EOVERFLOW
ಸ್ಥಿರ ಸಂಖ್ಯೆ ದೋಷ_ಅಕ್ಷರಾನುಕ್ರಮ = 84;   // EILSEQ

// ---------------------------------------------------------------
// ಕಡತಗಳ ಮೇಲಿನ ಕಾರ್ಯಾಚರಣೆಗಳು
// ---------------------------------------------------------------

ಬಾಹ್ಯ "kst_remove" ಕ್ರಿಯೆ ಅಳಿಸು(ಪದ ಹೆಸರು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                       // remove
ಬಾಹ್ಯ "kst_rename" ಕ್ರಿಯೆ ಮರುಹೆಸರಿಸು(ಪದ ಹಳೆಯ, ಪದ ಹೊಸ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;            // rename
ಬಾಹ್ಯ "kst_tmpfile" ಕ್ರಿಯೆ ತಾತ್ಕಾಲಿಕ_ಕಡತ() ಫಲಿತಾಂಶ ಕಡತ*;                       // tmpfile
ಬಾಹ್ಯ "kst_tmpnam" ಕ್ರಿಯೆ ತಾತ್ಕಾಲಿಕ_ಹೆಸರು(ಪದ ಸ್ಥಳ) ಫಲಿತಾಂಶ ಪದ;                  // tmpnam
ಬಾಹ್ಯ "kst_file_exists" ಕ್ರಿಯೆ ಕಡತ_ಇದೆಯೇ(ಪದ ಹೆಸರು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;

// ---------------------------------------------------------------
// ಕಡತ ಪ್ರವೇಶ
// ---------------------------------------------------------------

ಬಾಹ್ಯ "kst_fopen" ಕ್ರಿಯೆ ಕಡತ_ತೆರೆ(ಪದ ಹೆಸರು, ಪದ ವಿಧಾನ) ಫಲಿತಾಂಶ ಕಡತ*;               // fopen
ಬಾಹ್ಯ "kst_freopen" ಕ್ರಿಯೆ ಕಡತ_ಮರುತೆರೆ(ಪದ ಹೆಸರು, ಪದ ವಿಧಾನ, ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಕಡತ*; // freopen
ಬಾಹ್ಯ "kst_fclose" ಕ್ರಿಯೆ ಕಡತ_ಮುಚ್ಚು(ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                  // fclose
ಬಾಹ್ಯ "kst_fflush" ಕ್ರಿಯೆ ಕಡತ_ಹರಿಸು(ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                  // fflush
ಬಾಹ್ಯ "kst_setbuf" ಕ್ರಿಯೆ ಬಫರ್_ನಿಗದಿ(ಕಡತ* ಹರಿವು, ಪದ ಬಫರ್);                      // setbuf
ಬಾಹ್ಯ "kst_setvbuf" ಕ್ರಿಯೆ ಬಫರ್_ವಿಧ_ನಿಗದಿ(ಕಡತ* ಹರಿವು, ಪದ ಬಫರ್, ಸಂಖ್ಯೆ ವಿಧ, ದೀರ್ಘ ಅಳತೆ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ; // setvbuf

// ---------------------------------------------------------------
// ರೂಪಿತ ಹೊರಹರಿವು (printf ಕುಟುಂಬ)
// ---------------------------------------------------------------

ಬಾಹ್ಯ "kst_printf" ಕ್ರಿಯೆ ರೂಪಮುದ್ರಣ(ಪದ ರೂಪ, ...) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                         // printf
ಬಾಹ್ಯ "kst_fprintf" ಕ್ರಿಯೆ ಕಡತ_ರೂಪಮುದ್ರಣ(ಕಡತ* ಹರಿವು, ಪದ ರೂಪ, ...) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;         // fprintf
ಬಾಹ್ಯ "kst_sprintf" ಕ್ರಿಯೆ ಪದರೂಪಮುದ್ರಣ(ಪದ ಸ್ಥಳ, ಪದ ರೂಪ, ...) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;              // sprintf
ಬಾಹ್ಯ "kst_snprintf" ಕ್ರಿಯೆ ಮಿತ_ಪದರೂಪಮುದ್ರಣ(ಪದ ಸ್ಥಳ, ದೀರ್ಘ ಅಳತೆ, ಪದ ರೂಪ, ...) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ; // snprintf
ಬಾಹ್ಯ "kst_aprintf" ಕ್ರಿಯೆ ಪದರೂಪಿಸು(ಪದ ರೂಪ, ...) ಫಲಿತಾಂಶ ಪದ;                            // asprintf (ಹೊಸ ಸ್ಮರಣೆ)

ಬಾಹ್ಯ "kst_vprintf" ಕ್ರಿಯೆ ಪಟ್ಟಿ_ರೂಪಮುದ್ರಣ(ಪದ ರೂಪ, ಚರಪಟ್ಟಿ ಪಟ್ಟಿ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                       // vprintf
ಬಾಹ್ಯ "kst_vfprintf" ಕ್ರಿಯೆ ಪಟ್ಟಿ_ಕಡತ_ರೂಪಮುದ್ರಣ(ಕಡತ* ಹರಿವು, ಪದ ರೂಪ, ಚರಪಟ್ಟಿ ಪಟ್ಟಿ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;       // vfprintf
ಬಾಹ್ಯ "kst_vsprintf" ಕ್ರಿಯೆ ಪಟ್ಟಿ_ಪದರೂಪಮುದ್ರಣ(ಪದ ಸ್ಥಳ, ಪದ ರೂಪ, ಚರಪಟ್ಟಿ ಪಟ್ಟಿ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;            // vsprintf
ಬಾಹ್ಯ "kst_vsnprintf" ಕ್ರಿಯೆ ಪಟ್ಟಿ_ಮಿತ_ಪದರೂಪಮುದ್ರಣ(ಪದ ಸ್ಥಳ, ದೀರ್ಘ ಅಳತೆ, ಪದ ರೂಪ, ಚರಪಟ್ಟಿ ಪಟ್ಟಿ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ; // vsnprintf
ಬಾಹ್ಯ "kst_vaprintf" ಕ್ರಿಯೆ ಪಟ್ಟಿ_ಪದರೂಪಿಸು(ಪದ ರೂಪ, ಚರಪಟ್ಟಿ ಪಟ್ಟಿ) ಫಲಿತಾಂಶ ಪದ;                          // vasprintf

// ---------------------------------------------------------------
// ರೂಪಿತ ಒಳಹರಿವು (scanf ಕುಟುಂಬ) - ಕನ್ನಡ ಅಂಕಿಗಳನ್ನೂ ಸ್ವೀಕರಿಸುತ್ತದೆ
// ---------------------------------------------------------------

ಬಾಹ್ಯ "kst_scanf" ಕ್ರಿಯೆ ರೂಪಓದು(ಪದ ರೂಪ, ...) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                         // scanf
ಬಾಹ್ಯ "kst_fscanf" ಕ್ರಿಯೆ ಕಡತ_ರೂಪಓದು(ಕಡತ* ಹರಿವು, ಪದ ರೂಪ, ...) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;         // fscanf
ಬಾಹ್ಯ "kst_sscanf" ಕ್ರಿಯೆ ಪದರೂಪಓದು(ಪದ ಮೂಲ, ಪದ ರೂಪ, ...) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;              // sscanf
ಬಾಹ್ಯ "kst_vscanf" ಕ್ರಿಯೆ ಪಟ್ಟಿ_ರೂಪಓದು(ಪದ ರೂಪ, ಚರಪಟ್ಟಿ ಪಟ್ಟಿ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                 // vscanf
ಬಾಹ್ಯ "kst_vfscanf" ಕ್ರಿಯೆ ಪಟ್ಟಿ_ಕಡತ_ರೂಪಓದು(ಕಡತ* ಹರಿವು, ಪದ ರೂಪ, ಚರಪಟ್ಟಿ ಪಟ್ಟಿ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ; // vfscanf
ಬಾಹ್ಯ "kst_vsscanf" ಕ್ರಿಯೆ ಪಟ್ಟಿ_ಪದರೂಪಓದು(ಪದ ಮೂಲ, ಪದ ರೂಪ, ಚರಪಟ್ಟಿ ಪಟ್ಟಿ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;      // vsscanf

// ---------------------------------------------------------------
// ಅಕ್ಷರ ಒಳಹರಿವು / ಹೊರಹರಿವು
// ---------------------------------------------------------------

ಬಾಹ್ಯ "kst_fgetc" ಕ್ರಿಯೆ ಕಡತ_ಅಕ್ಷರಪಡೆ(ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                     // fgetc
ಬಾಹ್ಯ "kst_getc" ಕ್ರಿಯೆ ಹರಿವು_ಅಕ್ಷರಪಡೆ(ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                     // getc
ಬಾಹ್ಯ "kst_getchar" ಕ್ರಿಯೆ ಅಕ್ಷರಪಡೆ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                                  // getchar
ಬಾಹ್ಯ "kst_fgets" ಕ್ರಿಯೆ ಕಡತ_ಸಾಲುಪಡೆ(ಪದ ಸ್ಥಳ, ಸಂಖ್ಯೆ ಮಿತಿ, ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಪದ;    // fgets
ಬಾಹ್ಯ "kst_gets_s" ಕ್ರಿಯೆ ಸಾಲುಪಡೆ(ಪದ ಸ್ಥಳ, ದೀರ್ಘ ಮಿತಿ) ಫಲಿತಾಂಶ ಪದ;                     // gets_s
ಬಾಹ್ಯ "kst_getline" ಕ್ರಿಯೆ ಸಾಲು_ಓದು(ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಪದ;                          // ಸಂಪೂರ್ಣ ಸಾಲು (ಹೊಸ ಸ್ಮರಣೆ)
ಬಾಹ್ಯ "kst_fputc" ಕ್ರಿಯೆ ಕಡತ_ಅಕ್ಷರಹಾಕು(ಸಂಖ್ಯೆ ಅ, ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;            // fputc
ಬಾಹ್ಯ "kst_putc" ಕ್ರಿಯೆ ಹರಿವು_ಅಕ್ಷರಹಾಕು(ಸಂಖ್ಯೆ ಅ, ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;            // putc
ಬಾಹ್ಯ "kst_putchar" ಕ್ರಿಯೆ ಅಕ್ಷರಹಾಕು(ಸಂಖ್ಯೆ ಅ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                         // putchar
ಬಾಹ್ಯ "kst_fputs" ಕ್ರಿಯೆ ಕಡತ_ಪದಹಾಕು(ಪದ ಪ, ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                 // fputs
ಬಾಹ್ಯ "kst_puts" ಕ್ರಿಯೆ ಸಾಲುಹಾಕು(ಪದ ಪ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                                 // puts
ಬಾಹ್ಯ "kst_ungetc" ಕ್ರಿಯೆ ಅಕ್ಷರಹಿಂತಿರುಗಿಸು(ಸಂಖ್ಯೆ ಅ, ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;       // ungetc
ಬಾಹ್ಯ "kst_fputcp" ಕ್ರಿಯೆ ಸಂಕೇತ_ಹಾಕು(ಸಂಖ್ಯೆ ಸಂಕೇತ, ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;        // ಯುನಿಕೋಡ್ ಅಕ್ಷರ ಬರೆ
ಬಾಹ್ಯ "kst_fgetcp" ಕ್ರಿಯೆ ಸಂಕೇತ_ಪಡೆ(ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                       // ಯುನಿಕೋಡ್ ಅಕ್ಷರ ಓದು

// ---------------------------------------------------------------
// ನೇರ ಒಳಹರಿವು / ಹೊರಹರಿವು
// ---------------------------------------------------------------

ಬಾಹ್ಯ "kst_fread" ಕ್ರಿಯೆ ಕಡತ_ಓದು(ಶೂನ್ಯ* ಸ್ಥಳ, ದೀರ್ಘ ಅಳತೆ, ದೀರ್ಘ ಸಂಖ್ಯೆಗಳು, ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ದೀರ್ಘ;  // fread
ಬಾಹ್ಯ "kst_fwrite" ಕ್ರಿಯೆ ಕಡತ_ಬರೆ(ಶೂನ್ಯ* ಮೂಲ, ದೀರ್ಘ ಅಳತೆ, ದೀರ್ಘ ಸಂಖ್ಯೆಗಳು, ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ದೀರ್ಘ; // fwrite

// ---------------------------------------------------------------
// ಕಡತ ಸ್ಥಾನ
// ---------------------------------------------------------------

ಬಾಹ್ಯ "kst_fgetpos" ಕ್ರಿಯೆ ಸ್ಥಾನಪಡೆ(ಕಡತ* ಹರಿವು, ಕಡತಸ್ಥಾನ* ಸ್ಥಾನ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;            // fgetpos
ಬಾಹ್ಯ "kst_fsetpos" ಕ್ರಿಯೆ ಸ್ಥಾನನಿಗದಿ(ಕಡತ* ಹರಿವು, ಕಡತಸ್ಥಾನ* ಸ್ಥಾನ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;          // fsetpos
ಬಾಹ್ಯ "kst_fseek" ಕ್ರಿಯೆ ಕಡತ_ಸರಿಸು(ಕಡತ* ಹರಿವು, ದೀರ್ಘ ಅಂತರ, ಸಂಖ್ಯೆ ಮೂಲಸ್ಥಾನ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ; // fseek
ಬಾಹ್ಯ "kst_ftell" ಕ್ರಿಯೆ ಕಡತ_ಸ್ಥಾನ(ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ದೀರ್ಘ;                            // ftell
ಬಾಹ್ಯ "kst_rewind" ಕ್ರಿಯೆ ಹಿಂದಕ್ಕೆ_ಸುತ್ತು(ಕಡತ* ಹರಿವು);                                    // rewind

// ---------------------------------------------------------------
// ದೋಷ ನಿರ್ವಹಣೆ
// ---------------------------------------------------------------

ಬಾಹ್ಯ "kst_clearerr" ಕ್ರಿಯೆ ದೋಷ_ತೆರವು(ಕಡತ* ಹರಿವು);                       // clearerr
ಬಾಹ್ಯ "kst_feof" ಕ್ರಿಯೆ ಕಡತಾಂತವೇ(ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;              // feof
ಬಾಹ್ಯ "kst_ferror" ಕ್ರಿಯೆ ದೋಷವೇ(ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;               // ferror
ಬಾಹ್ಯ "kst_perror" ಕ್ರಿಯೆ ದೋಷ_ಮುದ್ರಿಸು(ಪದ ಸಂದೇಶ);                        // perror
ಬಾಹ್ಯ "kst_errno_get" ಕ್ರಿಯೆ ದೋಷಸಂಖ್ಯೆ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                  // errno
ಬಾಹ್ಯ "kst_errno_set" ಕ್ರಿಯೆ ದೋಷಸಂಖ್ಯೆ_ನಿಗದಿ(ಸಂಖ್ಯೆ ಮೌಲ್ಯ);              // errno = ...
ಬಾಹ್ಯ "kst_strerror" ಕ್ರಿಯೆ ದೋಷ_ಸಂದೇಶ(ಸಂಖ್ಯೆ ದೋಷ) ಫಲಿತಾಂಶ ಪದ;            // strerror (ಕನ್ನಡದಲ್ಲಿ)
ಬಾಹ್ಯ "kst_fileno_is_console" ಕ್ರಿಯೆ ಸಂವಾದಿಯೇ(ಕಡತ* ಹರಿವು) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;  // isatty
