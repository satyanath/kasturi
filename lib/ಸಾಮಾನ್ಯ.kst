// ಸಾಮಾನ್ಯ.kst - ಸಾಮಾನ್ಯ ಉಪಯುಕ್ತತೆಗಳು (C ಭಾಷೆಯ <stdlib.h> ಗೆ ಸಮಾನ)
//
//     ಆಮದು "ಸಾಮಾನ್ಯ";

ಸ್ಥಿರ ಸಂಖ್ಯೆ ಯಶಸ್ಸು = 0;                    // EXIT_SUCCESS
ಸ್ಥಿರ ಸಂಖ್ಯೆ ವೈಫಲ್ಯ = 1;                    // EXIT_FAILURE
ಸ್ಥಿರ ಸಂಖ್ಯೆ ಯಾದೃಚ್ಛಿಕ_ಗರಿಷ್ಠ = 2147483647;  // RAND_MAX

// ---- ಸ್ಮರಣೆ ನಿರ್ವಹಣೆ ----
ಬಾಹ್ಯ "kst_malloc" ಕ್ರಿಯೆ ಸ್ಮರಣೆ_ಪಡೆ(ದೀರ್ಘ ಅಳತೆ) ಫಲಿತಾಂಶ ಶೂನ್ಯ*;                              // malloc
ಬಾಹ್ಯ "kst_calloc" ಕ್ರಿಯೆ ಸೊನ್ನೆ_ಸ್ಮರಣೆ(ದೀರ್ಘ ಸಂಖ್ಯೆಗಳು, ದೀರ್ಘ ಅಳತೆ) ಫಲಿತಾಂಶ ಶೂನ್ಯ*;              // calloc
ಬಾಹ್ಯ "kst_realloc" ಕ್ರಿಯೆ ಸ್ಮರಣೆ_ಮರುಗಾತ್ರ(ಶೂನ್ಯ* ಹಳೆಯ, ದೀರ್ಘ ಅಳತೆ) ಫಲಿತಾಂಶ ಶೂನ್ಯ*;             // realloc
ಬಾಹ್ಯ "kst_free" ಕ್ರಿಯೆ ಸ್ಮರಣೆ_ಬಿಡು(ಶೂನ್ಯ* ಸ್ಥಳ);                                                // free
ಬಾಹ್ಯ "kst_memcpy" ಕ್ರಿಯೆ ಸ್ಮರಣೆ_ನಕಲು(ಶೂನ್ಯ* ಗುರಿ, ಶೂನ್ಯ* ಮೂಲ, ದೀರ್ಘ ಅಳತೆ) ಫಲಿತಾಂಶ ಶೂನ್ಯ*;        // memcpy
ಬಾಹ್ಯ "kst_memmove" ಕ್ರಿಯೆ ಸ್ಮರಣೆ_ಸರಿಸು(ಶೂನ್ಯ* ಗುರಿ, ಶೂನ್ಯ* ಮೂಲ, ದೀರ್ಘ ಅಳತೆ) ಫಲಿತಾಂಶ ಶೂನ್ಯ*;      // memmove
ಬಾಹ್ಯ "kst_memset" ಕ್ರಿಯೆ ಸ್ಮರಣೆ_ತುಂಬು(ಶೂನ್ಯ* ಗುರಿ, ಸಂಖ್ಯೆ ಮೌಲ್ಯ, ದೀರ್ಘ ಅಳತೆ) ಫಲಿತಾಂಶ ಶೂನ್ಯ*;     // memset
ಬಾಹ್ಯ "kst_memcmp" ಕ್ರಿಯೆ ಸ್ಮರಣೆ_ಹೋಲಿಸು(ಶೂನ್ಯ* ಮೊದಲ, ಶೂನ್ಯ* ಎರಡನೇ, ದೀರ್ಘ ಅಳತೆ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;  // memcmp

// ---- ಕಾರ್ಯಕ್ರಮ / ಪರಿಸರ ----
ಬಾಹ್ಯ "kst_exit" ಕ್ರಿಯೆ ನಿರ್ಗಮಿಸು(ಸಂಖ್ಯೆ ಸ್ಥಿತಿ);                         // exit
ಬಾಹ್ಯ "kst_abort" ಕ್ರಿಯೆ ಸ್ಥಗಿತಗೊಳಿಸು();                                // abort
ಬಾಹ್ಯ "kst_system" ಕ್ರಿಯೆ ಆದೇಶ_ಚಲಾಯಿಸು(ಪದ ಆದೇಶ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;          // system
ಬಾಹ್ಯ "kst_getenv" ಕ್ರಿಯೆ ಪರಿಸರ_ಮೌಲ್ಯ(ಪದ ಹೆಸರು) ಫಲಿತಾಂಶ ಪದ;              // getenv
ಬಾಹ್ಯ "kst_rt_argc" ಕ್ರಿಯೆ ಚರಾಂಶಗಳ_ಸಂಖ್ಯೆ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;              // argc
ಬಾಹ್ಯ "kst_rt_argv" ಕ್ರಿಯೆ ಚರಾಂಶಗಳು() ಫಲಿತಾಂಶ ಪದ*;                       // argv

// ---- ಪರಿವರ್ತನೆ (ಕನ್ನಡ ಅಂಕಿಗಳನ್ನೂ ಸ್ವೀಕರಿಸುತ್ತವೆ) ----
ಬಾಹ್ಯ "kst_atoi" ಕ್ರಿಯೆ ಪದದಿಂದ_ಸಂಖ್ಯೆ(ಪದ ಪ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                          // atoi
ಬಾಹ್ಯ "kst_atoll" ಕ್ರಿಯೆ ಪದದಿಂದ_ದೀರ್ಘ(ಪದ ಪ) ಫಲಿತಾಂಶ ದೀರ್ಘ;                          // atoll
ಬಾಹ್ಯ "kst_atof" ಕ್ರಿಯೆ ಪದದಿಂದ_ದಶಾಂಶ(ಪದ ಪ) ಫಲಿತಾಂಶ ದಶಾಂಶ;                          // atof
ಬಾಹ್ಯ "kst_strtoll" ಕ್ರಿಯೆ ಪದ_ದೀರ್ಘಕ್ಕೆ(ಪದ ಪ, ಪದ* ಅಂತ್ಯ, ಸಂಖ್ಯೆ ಆಧಾರ) ಫಲಿತಾಂಶ ದೀರ್ಘ;  // strtoll
ಬಾಹ್ಯ "kst_strtod" ಕ್ರಿಯೆ ಪದ_ದಶಾಂಶಕ್ಕೆ(ಪದ ಪ, ಪದ* ಅಂತ್ಯ) ಫಲಿತಾಂಶ ದಶಾಂಶ;               // strtod
ಬಾಹ್ಯ "kst_int_to_str" ಕ್ರಿಯೆ ಸಂಖ್ಯೆಯಿಂದ_ಪದ(ದೀರ್ಘ ಮೌಲ್ಯ) ಫಲಿತಾಂಶ ಪದ;                 // ಹೊಸ ಸ್ಮರಣೆ
ಬಾಹ್ಯ "kst_int_to_str_kn" ಕ್ರಿಯೆ ಕನ್ನಡ_ಅಂಕಿಪದ(ದೀರ್ಘ ಮೌಲ್ಯ) ಫಲಿತಾಂಶ ಪದ;              // ೧೨೩ ರೂಪದಲ್ಲಿ
ಬಾಹ್ಯ "kst_float_to_str" ಕ್ರಿಯೆ ದಶಾಂಶದಿಂದ_ಪದ(ದಶಾಂಶ ಮೌಲ್ಯ) ಫಲಿತಾಂಶ ಪದ;

// ---- ಪೂರ್ಣಾಂಕ ಗಣಿತ ----
ಬಾಹ್ಯ "kst_abs" ಕ್ರಿಯೆ ನಿರಪೇಕ್ಷ(ಸಂಖ್ಯೆ ಮೌಲ್ಯ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                 // abs
ಬಾಹ್ಯ "kst_llabs" ಕ್ರಿಯೆ ದೀರ್ಘ_ನಿರಪೇಕ್ಷ(ದೀರ್ಘ ಮೌಲ್ಯ) ಫಲಿತಾಂಶ ದೀರ್ಘ;          // llabs
ಬಾಹ್ಯ "kst_min" ಕ್ರಿಯೆ ಕನಿಷ್ಠ(ಸಂಖ್ಯೆ ಅ, ಸಂಖ್ಯೆ ಬ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;
ಬಾಹ್ಯ "kst_max" ಕ್ರಿಯೆ ಗರಿಷ್ಠ(ಸಂಖ್ಯೆ ಅ, ಸಂಖ್ಯೆ ಬ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;
ಬಾಹ್ಯ "kst_llmin" ಕ್ರಿಯೆ ದೀರ್ಘ_ಕನಿಷ್ಠ(ದೀರ್ಘ ಅ, ದೀರ್ಘ ಬ) ಫಲಿತಾಂಶ ದೀರ್ಘ;
ಬಾಹ್ಯ "kst_llmax" ಕ್ರಿಯೆ ದೀರ್ಘ_ಗರಿಷ್ಠ(ದೀರ್ಘ ಅ, ದೀರ್ಘ ಬ) ಫಲಿತಾಂಶ ದೀರ್ಘ;

// ---- ಯಾದೃಚ್ಛಿಕ ಸಂಖ್ಯೆಗಳು ----
ಬಾಹ್ಯ "kst_rand" ಕ್ರಿಯೆ ಯಾದೃಚ್ಛಿಕ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;                                     // rand
ಬಾಹ್ಯ "kst_srand" ಕ್ರಿಯೆ ಯಾದೃಚ್ಛಿಕ_ಬೀಜ(ದೀರ್ಘ ಬೀಜ);                                       // srand
ಬಾಹ್ಯ "kst_rand_range" ಕ್ರಿಯೆ ಯಾದೃಚ್ಛಿಕ_ವ್ಯಾಪ್ತಿ(ಸಂಖ್ಯೆ ಕೆಳ, ಸಂಖ್ಯೆ ಮೇಲ್) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ;  // [ಕೆಳ, ಮೇಲ್]
ಬಾಹ್ಯ "kst_rand_unit" ಕ್ರಿಯೆ ಯಾದೃಚ್ಛಿಕ_ದಶಾಂಶ() ಫಲಿತಾಂಶ ದಶಾಂಶ;                           // [0, 1)

// ---- ಸಮಯ ----
ಬಾಹ್ಯ "kst_time" ಕ್ರಿಯೆ ಪ್ರಸ್ತುತ_ಸಮಯ() ಫಲಿತಾಂಶ ದೀರ್ಘ;        // time(NULL), ಸೆಕೆಂಡುಗಳು
ಬಾಹ್ಯ "kst_clock" ಕ್ರಿಯೆ ಗಡಿಯಾರ() ಫಲಿತಾಂಶ ದಶಾಂಶ;             // ಸಂಸ್ಕರಣಾ ಸಮಯ, ಸೆಕೆಂಡುಗಳು

// ---- ಕಸ್ತೂರಿಯಲ್ಲೇ ಬರೆದ ಸಹಾಯಕ ಕ್ರಿಯೆಗಳು ----

// ಪೂರ್ಣಾಂಕ ಸರಣಿಯನ್ನು ಏರಿಕೆ ಕ್ರಮದಲ್ಲಿ ವಿಂಗಡಿಸುತ್ತದೆ (insertion sort)
ಕ್ರಿಯೆ ಸಂಖ್ಯೆಗಳನ್ನು_ವಿಂಗಡಿಸು(ಸಂಖ್ಯೆ* ಸರಣಿ, ಸಂಖ್ಯೆ ಪರಿಮಾಣ) {
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 1; ಇ < ಪರಿಮಾಣ; ಇ++) {
        ಸಂಖ್ಯೆ ಕೀಲಿ = ಸರಣಿ[ಇ];
        ಸಂಖ್ಯೆ ಜ = ಇ - 1;
        (ಜ >= 0 && ಸರಣಿ[ಜ] > ಕೀಲಿ) ಸಮಯವರೆಗೆ {
            ಸರಣಿ[ಜ + 1] = ಸರಣಿ[ಜ];
            ಜ--;
        }
        ಸರಣಿ[ಜ + 1] = ಕೀಲಿ;
    }
}

// ವಿಂಗಡಿಸಿದ ಸರಣಿಯಲ್ಲಿ ದ್ವಿಮಾನ ಹುಡುಕಾಟ; ಸಿಗದಿದ್ದರೆ -1
ಕ್ರಿಯೆ ದ್ವಿಮಾನ_ಹುಡುಕು(ಸಂಖ್ಯೆ* ಸರಣಿ, ಸಂಖ್ಯೆ ಪರಿಮಾಣ, ಸಂಖ್ಯೆ ಗುರಿ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ಸಂಖ್ಯೆ ಕೆಳ = 0, ಮೇಲ್ = ಪರಿಮಾಣ - 1;
    (ಕೆಳ <= ಮೇಲ್) ಸಮಯವರೆಗೆ {
        ಸಂಖ್ಯೆ ಮಧ್ಯ = ಕೆಳ + (ಮೇಲ್ - ಕೆಳ) / 2;
        (ಸರಣಿ[ಮಧ್ಯ] == ಗುರಿ) ಆದರೆ ಮರಳಿ ಮಧ್ಯ;
        (ಸರಣಿ[ಮಧ್ಯ] < ಗುರಿ) ಆದರೆ ಕೆಳ = ಮಧ್ಯ + 1;
        ಇಲ್ಲವಾದರೆ ಮೇಲ್ = ಮಧ್ಯ - 1;
    }
    ಮರಳಿ -1;
}
