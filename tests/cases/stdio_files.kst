// ಐಒ ಗ್ರಂಥಾಲಯ: ಕಡತಗಳು, ಸ್ಥಾನ, ನೇರ ಓದು/ಬರೆ, ದೋಷಗಳು

ಆಮದು "ಐಒ";
ಆಮದು "ಸಾಮಾನ್ಯ";

ರಚನೆ ದಾಖಲೆ {
    ಸಂಖ್ಯೆ ಸಂಖ್ಯಾ;
    ದಶಾಂಶ ಮೌಲ್ಯ;
};

ಕ್ರಿಯೆ ಮುಖ್ಯ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ಪದ ಹೆಸರು = "ಪರೀಕ್ಷೆ_ಕಡತ.txt";

    // ಬರೆಯುವುದು
    ಕಡತ* ಕ = ಕಡತ_ತೆರೆ(ಹೆಸರು, "w");
    (ಕ == ಖಾಲಿ) ಆದರೆ {
        ದೋಷ_ಮುದ್ರಿಸು("ತೆರೆಯಲಾಗಲಿಲ್ಲ");
        ಮರಳಿ 1;
    }
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 1; ಇ <= 3; ಇ++) ಕಡತ_ರೂಪಮುದ್ರಣ(ಕ, "ಸಾಲು %d: %s\n", ಇ, "ಕನ್ನಡ");
    ಕಡತ_ಪದಹಾಕು("ಕೊನೆ\n", ಕ);
    ಕಡತ_ಅಕ್ಷರಹಾಕು('!', ಕ);
    ಕಡತ_ಮುಚ್ಚು(ಕ);

    // ಸಾಲು ಸಾಲಾಗಿ ಓದುವುದು
    ಕ = ಕಡತ_ತೆರೆ(ಹೆಸರು, "r");
    ಅಕ್ಷರ ಸಾಲು[128];
    ಸಂಖ್ಯೆ ಎಣಿಕೆ_ಸಂ = 0;
    (ಕಡತ_ಸಾಲುಪಡೆ(ಸಾಲು, 128, ಕ) != ಖಾಲಿ) ಸಮಯವರೆಗೆ {
        ಎಣಿಕೆ_ಸಂ++;
        ಮುದ್ರಿಸು("> ", ಸಾಲು);
    }
    ಸಾಲುಮುದ್ರಿಸು();
    ಸಾಲುಮುದ್ರಿಸು("ಸಾಲುಗಳು: ", ಎಣಿಕೆ_ಸಂ, ", ಕಡತಾಂತ: ", ಕಡತಾಂತವೇ(ಕ) != 0);

    // ಸ್ಥಾನ
    ಹಿಂದಕ್ಕೆ_ಸುತ್ತು(ಕ);
    ಸಾಲುಮುದ್ರಿಸು("ಮೊದಲ ಅಕ್ಷರ ಸಂಕೇತ: ", ಸಂಕೇತ_ಪಡೆ(ಕ), " ಸ್ಥಾನ: ", ಕಡತ_ಸ್ಥಾನ(ಕ));
    ಕಡತ_ಸರಿಸು(ಕ, 0, ಕೊನೆಯಿಂದ);
    ದೀರ್ಘ ಅಳತೆ = ಕಡತ_ಸ್ಥಾನ(ಕ);
    ಸಾಲುಮುದ್ರಿಸು("ಕಡತದ ಗಾತ್ರ > 50: ", ಅಳತೆ > 50);
    ಕಡತಸ್ಥಾನ ಗುರುತು;
    ಕಡತ_ಸರಿಸು(ಕ, 0, ಆರಂಭದಿಂದ);
    ಸ್ಥಾನಪಡೆ(ಕ, &ಗುರುತು);
    ಕಡತ_ಅಕ್ಷರಪಡೆ(ಕ);
    ಸ್ಥಾನನಿಗದಿ(ಕ, &ಗುರುತು);
    ಅಕ್ಷರಹಿಂತಿರುಗಿಸು('Z', ಕ);
    ಸಾಲುಮುದ್ರಿಸು("ಹಿಂತಿರುಗಿಸಿದ: ", (ಅಕ್ಷರ) ಕಡತ_ಅಕ್ಷರಪಡೆ(ಕ));
    ಕಡತ_ಮುಚ್ಚು(ಕ);

    // ಸೇರಿಸುವ ವಿಧಾನ ಮತ್ತು ಸಂಪೂರ್ಣ ಸಾಲು
    ಕ = ಕಡತ_ತೆರೆ(ಹೆಸರು, "a+");
    ಕಡತ_ಪದಹಾಕು("\nಹೊಸ ಸಾಲು", ಕ);
    ಹಿಂದಕ್ಕೆ_ಸುತ್ತು(ಕ);
    ಪದ ಪೂರ್ಣ = ಸಾಲು_ಓದು(ಕ);
    ಸಾಲುಮುದ್ರಿಸು("ಮೊದಲ ಸಾಲು: ", ಪೂರ್ಣ);
    ಸ್ಮರಣೆ_ಬಿಡು(ಪೂರ್ಣ);
    ಕಡತ_ಮುಚ್ಚು(ಕ);

    // ದ್ವಿಮಾನ ಓದು / ಬರೆ
    ದಾಖಲೆ ಬರೆಯಲು[3] = {{1, 1.5}, {2, 2.5}, {3, 3.5}};
    ಕ = ಕಡತ_ತೆರೆ("ದತ್ತಾಂಶ.bin", "wb");
    ಸಾಲುಮುದ್ರಿಸು("ಬರೆದದ್ದು: ", ಕಡತ_ಬರೆ(ಬರೆಯಲು, ಗಾತ್ರ(ದಾಖಲೆ), 3, ಕ));
    ಕಡತ_ಮುಚ್ಚು(ಕ);
    ದಾಖಲೆ ಓದಲು[3];
    ಕ = ಕಡತ_ತೆರೆ("ದತ್ತಾಂಶ.bin", "rb");
    ಸಾಲುಮುದ್ರಿಸು("ಓದಿದ್ದು: ", ಕಡತ_ಓದು(ಓದಲು, ಗಾತ್ರ(ದಾಖಲೆ), 3, ಕ));
    ಕಡತ_ಮುಚ್ಚು(ಕ);
    ಸಾಲುಮುದ್ರಿಸು(ಓದಲು[2].ಸಂಖ್ಯಾ, " ", ಓದಲು[2].ಮೌಲ್ಯ);

    // ತಾತ್ಕಾಲಿಕ ಕಡತ ಮತ್ತು ರೂಪಓದು
    ಕಡತ* ತಾ = ತಾತ್ಕಾಲಿಕ_ಕಡತ();
    ಕಡತ_ರೂಪಮುದ್ರಣ(ತಾ, "%d %lf %s", 77, 0.25, "ಪದ");
    ಹಿಂದಕ್ಕೆ_ಸುತ್ತು(ತಾ);
    ಸಂಖ್ಯೆ ನ;
    ದಶಾಂಶ ದ;
    ಅಕ್ಷರ ಪ[32];
    ಸಂಖ್ಯೆ ಸಿಕ್ಕಿದ್ದು = ಕಡತ_ರೂಪಓದು(ತಾ, "%d %lf %31s", &ನ, &ದ, ಪ);
    ಸಾಲುಮುದ್ರಿಸು(ಸಿಕ್ಕಿದ್ದು, ": ", ನ, " ", ದ, " ", ಪ);
    ಕಡತ_ಮುಚ್ಚು(ತಾ);

    // ಮರುಹೆಸರು, ಅಳಿಸು, ದೋಷಗಳು
    ಸಾಲುಮುದ್ರಿಸು(ಮರುಹೆಸರಿಸು(ಹೆಸರು, "ಹೊಸ_ಹೆಸರು.txt"), " ", ಕಡತ_ಇದೆಯೇ("ಹೊಸ_ಹೆಸರು.txt"), " ", ಕಡತ_ಇದೆಯೇ(ಹೆಸರು));
    ಸಾಲುಮುದ್ರಿಸು(ಅಳಿಸು("ಹೊಸ_ಹೆಸರು.txt"), " ", ಅಳಿಸು("ದತ್ತಾಂಶ.bin"));
    ಕಡತ* ಇಲ್ಲದ = ಕಡತ_ತೆರೆ("ಇಲ್ಲದ_ಕೋಶ/ಇಲ್ಲದ.txt", "r");
    ಸಾಲುಮುದ್ರಿಸು(ಇಲ್ಲದ == ಖಾಲಿ, " ", ದೋಷಸಂಖ್ಯೆ() == ದೋಷ_ಕಡತವಿಲ್ಲ, " ", ದೋಷ_ಸಂದೇಶ(ದೋಷ_ಕಡತವಿಲ್ಲ));

    // ಪದದೊಳಗೆ ರೂಪಮುದ್ರಣ
    ಅಕ್ಷರ ಸ್ಥಳ[64];
    ಸಂಖ್ಯೆ ಉದ್ದ_ಸಂ = ಮಿತ_ಪದರೂಪಮುದ್ರಣ(ಸ್ಥಳ, 8, "%s-%d", "abcdef", 12345);
    ಸಾಲುಮುದ್ರಿಸು(ಸ್ಥಳ, " ", ಉದ್ದ_ಸಂ);
    ಪದರೂಪಮುದ್ರಣ(ಸ್ಥಳ, "[%5.1f]", 3.14159);
    ಸಾಲುಮುದ್ರಿಸು(ಸ್ಥಳ);
    ಸಂಖ್ಯೆ ಅ, ಬ;
    ಪದರೂಪಓದು("೧೨:೩೪", "%d:%d", &ಅ, &ಬ);
    ಸಾಲುಮುದ್ರಿಸು(ಅ + ಬ);

    ಕಡತ_ಪದಹಾಕು("ದೋಷಹರಿವು ಪರೀಕ್ಷೆ\n", ದೋಷಹರಿವು);
    ಸಾಲುಹಾಕು("ಸಾಲುಹಾಕು ಮುಗಿಯಿತು");
    ಮರಳಿ 0;
}
