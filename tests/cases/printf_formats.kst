// ರೂಪಮುದ್ರಣ ರೂಪ ನಿರ್ದೇಶಕಗಳು

ಆಮದು "ಐಒ";

ಕ್ರಿಯೆ ಮುಖ್ಯ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ರೂಪಮುದ್ರಣ("[%d] [%5d] [%-5d] [%05d] [%+d] [% d]\n", 42, 42, 42, 42, 42, 42);
    ರೂಪಮುದ್ರಣ("[%x] [%X] [%#x] [%o] [%#o] [%b]\n", 255, 255, 255, 8, 8, 5);
    ರೂಪಮುದ್ರಣ("[%u] [%lld] [%.3d]\n", 3000000000, 9223372036854775807, 7);
    ರೂಪಮುದ್ರಣ("[%f] [%.2f] [%10.3f] [%-10.1f] [%e] [%.3E]\n", 3.14159265, 2.675, 1.0005, -0.25, 12345.678, 0.000123);
    ರೂಪಮುದ್ರಣ("[%g] [%g] [%g] [%.10g] [%a]\n", 100000.0, 1000000.0, 0.0001, 1.0 / 3.0, 1.0);
    ರೂಪಮುದ್ರಣ("[%s] [%10s] [%-10s] [%.2s]\n", "abc", "abc", "abc", "abc");
    ರೂಪಮುದ್ರಣ("[%c] [%3c] [%lc] [%%]\n", 'x', 'y', 'ಕ');
    ರೂಪಮುದ್ರಣ("[%*d] [%-*d] [%.*f]\n", 6, 1, 6, 2, 3, 2.0);
    ರೂಪಮುದ್ರಣ("[%~d] [%~.2f] [%~x] [%~5d]\n", 1234567890, 98.765, 255, 42);
    ರೂಪಮುದ್ರಣ("[%s]\n", ಖಾಲಿ);
    ಸಂಖ್ಯೆ ಎಷ್ಟು = 0;
    ರೂಪಮುದ್ರಣ("ಕನ್ನಡ%n", &ಎಷ್ಟು);
    ರೂಪಮುದ್ರಣ(" -> %d ಬೈಟ್\n", ಎಷ್ಟು);
    ಪದ ಪ = ಪದರೂಪಿಸು("%s=%d", "ಮೌಲ್ಯ", 10);
    ರೂಪಮುದ್ರಣ("%s (%d)\n", ಪ, ರೂಪಮುದ್ರಣ(""));
    ಮರಳಿ 0;
}
