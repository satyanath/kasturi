// ರಚನೆಗಳು: ಗೂಡು ರಚನೆಗಳು, ರಚನೆ ಸರಣಿಗಳು, ಸೂಚಿಗಳು, ಸಂಪರ್ಕಿತ ಪಟ್ಟಿ

ಆಮದು "ಸಾಮಾನ್ಯ";

ರಚನೆ ಬಿಂದು {
    ದಶಾಂಶ ಕ, ಯ;
};

ರಚನೆ ಆಯತ {
    ಬಿಂದು ಮೇಲ್ಎಡ;
    ಬಿಂದು ಕೆಳಬಲ;
    ಪದ ಹೆಸರು;
};

ರಚನೆ ಗಂಟು {
    ಸಂಖ್ಯೆ ಮೌಲ್ಯ;
    ಗಂಟು* ಮುಂದಿನ;
};

ರಚನೆ ವಿದ್ಯಾರ್ಥಿ {
    ಅಕ್ಷರ ಹೆಸರು[32];
    ಸಂಖ್ಯೆ ಅಂಕಗಳು[3];
};

ಕ್ರಿಯೆ ವಿಸ್ತೀರ್ಣ(ಆಯತ* ಆ) ಫಲಿತಾಂಶ ದಶಾಂಶ {
    ದಶಾಂಶ ಅಗಲ = ಆ->ಕೆಳಬಲ.ಕ - ಆ->ಮೇಲ್ಎಡ.ಕ;
    ದಶಾಂಶ ಎತ್ತರ = ಆ->ಕೆಳಬಲ.ಯ - ಆ->ಮೇಲ್ಎಡ.ಯ;
    ಮರಳಿ ಅಗಲ * ಎತ್ತರ;
}

ಕ್ರಿಯೆ ಸೇರಿಸು_ಮುಂದೆ(ಗಂಟು* ತಲೆ, ಸಂಖ್ಯೆ ಮೌಲ್ಯ) ಫಲಿತಾಂಶ ಗಂಟು* {
    ಗಂಟು* ಹೊಸ = ಸ್ಮರಣೆ_ಪಡೆ(ಗಾತ್ರ(ಗಂಟು));
    ಹೊಸ->ಮೌಲ್ಯ = ಮೌಲ್ಯ;
    ಹೊಸ->ಮುಂದಿನ = ತಲೆ;
    ಮರಳಿ ಹೊಸ;
}

ಕ್ರಿಯೆ ಸರಾಸರಿ(ವಿದ್ಯಾರ್ಥಿ ವಿ) ಫಲಿತಾಂಶ ದಶಾಂಶ {
    ಮರಳಿ (ವಿ.ಅಂಕಗಳು[0] + ವಿ.ಅಂಕಗಳು[1] + ವಿ.ಅಂಕಗಳು[2]) / 3.0;
}

ಕ್ರಿಯೆ ಮುಖ್ಯ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ಆಯತ ಆ;
    ಆ.ಮೇಲ್ಎಡ.ಕ = 1.0;
    ಆ.ಮೇಲ್ಎಡ.ಯ = 2.0;
    ಆ.ಕೆಳಬಲ.ಕ = 4.0;
    ಆ.ಕೆಳಬಲ.ಯ = 6.5;
    ಆ.ಹೆಸರು = "ಪೆಟ್ಟಿಗೆ";
    ಸಾಲುಮುದ್ರಿಸು(ಆ.ಹೆಸರು, " ವಿಸ್ತೀರ್ಣ = ", ವಿಸ್ತೀರ್ಣ(&ಆ));

    ಬಿಂದು ಬಿಂದುಗಳು[3] = {{0.0, 0.0}, {3.0, 4.0}, {6.0, 8.0}};
    ಬಿಂದು ನಕಲು = ಬಿಂದುಗಳು[1];
    ನಕಲು.ಕ = 100.0;
    ಸಾಲುಮುದ್ರಿಸು(ಬಿಂದುಗಳು[1].ಕ, " ", ನಕಲು.ಕ, " ", ಬಿಂದುಗಳು[2].ಯ);

    ಗಂಟು* ತಲೆ = ಖಾಲಿ;
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 1; ಇ <= 5; ಇ++) ತಲೆ = ಸೇರಿಸು_ಮುಂದೆ(ತಲೆ, ಇ * ಇ);
    ಗಂಟು* ಪ್ರಸ್ತುತ = ತಲೆ;
    (ಪ್ರಸ್ತುತ != ಖಾಲಿ) ಸಮಯವರೆಗೆ {
        ಮುದ್ರಿಸು(ಪ್ರಸ್ತುತ->ಮೌಲ್ಯ, " -> ");
        ಪ್ರಸ್ತುತ = ಪ್ರಸ್ತುತ->ಮುಂದಿನ;
    }
    ಸಾಲುಮುದ್ರಿಸು("ಖಾಲಿ");
    (ತಲೆ != ಖಾಲಿ) ಸಮಯವರೆಗೆ {
        ಗಂಟು* ಮುಂದೆ = ತಲೆ->ಮುಂದಿನ;
        ಸ್ಮರಣೆ_ಬಿಡು(ತಲೆ);
        ತಲೆ = ಮುಂದೆ;
    }

    ವಿದ್ಯಾರ್ಥಿ ವಿ = {"ಸೀತಾ", {80, 90, 85}};
    ಸಾಲುಮುದ್ರಿಸು(ವಿ.ಹೆಸರು, ": ", ಸರಾಸರಿ(ವಿ));
    ಸಾಲುಮುದ್ರಿಸು(ಗಾತ್ರ(ಬಿಂದು), " ", ಗಾತ್ರ(ವಿದ್ಯಾರ್ಥಿ));
    ಮರಳಿ 0;
}
