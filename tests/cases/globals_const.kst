// ಜಾಗತಿಕ ಚರಗಳು, ಸ್ಥಿರಾಂಕಗಳು, ಸ್ಥಿರಾಂಕ ಮಡಚುವಿಕೆ, ಬಿಟ್ ನಿರ್ವಾಹಕಗಳು, ಎರಕ

ಸ್ಥಿರ ಸಂಖ್ಯೆ ಗರಿಷ್ಠ = 4 * 2 + 2;
ಸ್ಥಿರ ಸಂಖ್ಯೆ ಕೆಂಪು = 1, ಹಸಿರು = 2, ನೀಲಿ = 4;
ಸ್ಥಿರ ದಶಾಂಶ ದರ = 0.5 * 3;
ಸ್ಥಿರ ಪದ ಆವೃತ್ತಿ = "೧.೦";

ಸಂಖ್ಯೆ ಎಣಿಕೆದಾರ;
ಸಂಖ್ಯೆ ಸರಣಿ[ಗರಿಷ್ಠ];
ದೀರ್ಘ ದೊಡ್ಡ = 1 << 40;
ಪದ ಸಂದೇಶ = "ಜಾಗತಿಕ";

ರಚನೆ ಕೋಷ್ಟಕ {
    ಸಂಖ್ಯೆ ಕೋಶಗಳು[ಗರಿಷ್ಠ / 2][ನೀಲಿ];
};

ಕ್ರಿಯೆ ಹೆಚ್ಚಿಸು() {
    ಎಣಿಕೆದಾರ++;
}

ಕ್ರಿಯೆ ಬಣ್ಣ(ಸಂಖ್ಯೆ ಬ) ಫಲಿತಾಂಶ ಪದ {
    ಆಯ್ಕೆ (ಬ) {
        ಸಂದರ್ಭ ಕೆಂಪು: ಮರಳಿ "ಕೆಂಪು";
        ಸಂದರ್ಭ ಹಸಿರು: ಮರಳಿ "ಹಸಿರು";
        ಸಂದರ್ಭ ಕೆಂಪು | ಹಸಿರು: ಮರಳಿ "ಹಳದಿ";
        ಸಂದರ್ಭ ನೀಲಿ: ಮರಳಿ "ನೀಲಿ";
    }
    ಮರಳಿ "?";
}

ಕ್ರಿಯೆ ಮುಖ್ಯ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 0; ಇ < 5; ಇ++) ಹೆಚ್ಚಿಸು();
    ಸಾಲುಮುದ್ರಿಸು(ಎಣಿಕೆದಾರ, " ", ಗರಿಷ್ಠ, " ", ಗಾತ್ರ(ಸರಣಿ) / ಗಾತ್ರ(ಸಂಖ್ಯೆ), " ", ದರ, " ", ಆವೃತ್ತಿ);
    ಸಾಲುಮುದ್ರಿಸು(ದೊಡ್ಡ, " ", ಸಂದೇಶ);
    ಸಾಲುಮುದ್ರಿಸು(ಬಣ್ಣ(1), " ", ಬಣ್ಣ(3), " ", ಬಣ್ಣ(4), " ", ಬಣ್ಣ(8));

    ಸಂಖ್ಯೆ ಅ = 0b1100, ಬ = 0b1010;
    ಸಾಲುಮುದ್ರಿಸು(ಅ & ಬ, " ", ಅ | ಬ, " ", ಅ ^ ಬ, " ", ~ಅ, " ", ಅ << 2, " ", ಅ >> 2);
    ಅ &= 4;
    ಅ |= 1;
    ಅ ^= 3;
    ಅ <<= 3;
    ಅ >>= 1;
    ಸಾಲುಮುದ್ರಿಸು(ಅ);

    ದಶಾಂಶ ದ = 7.9;
    ಸಾಲುಮುದ್ರಿಸು((ಸಂಖ್ಯೆ) ದ, " ", (ದಶಾಂಶ) 7 / 2, " ", 7 / 2, " ", (ಅಕ್ಷರ) 65, " ", (ತಾರ್ಕಿಕ) 5);
    ದೀರ್ಘ ದೊ = 2147483647;
    ದೊ = ದೊ + 1;
    ಸಾಲುಮುದ್ರಿಸು(ದೊ);

    ಕೋಷ್ಟಕ ಕೋ;
    ಕೋ.ಕೋಶಗಳು[4][3] = 99;
    ಸಾಲುಮುದ್ರಿಸು(ಗಾತ್ರ(ಕೋಷ್ಟಕ), " ", ಕೋ.ಕೋಶಗಳು[4][3], " ", ಕೋ.ಕೋಶಗಳು[0][0]);
    ಮರಳಿ 0;
}
