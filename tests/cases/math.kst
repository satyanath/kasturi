// ಗಣಿತ ಮತ್ತು ಸಾಮಾನ್ಯ ಗ್ರಂಥಾಲಯಗಳು

ಆಮದು "ಗಣಿತ";
ಆಮದು "ಸಾಮಾನ್ಯ";
ಆಮದು "ಐಒ";

ಕ್ರಿಯೆ ಮುಖ್ಯ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ರೂಪಮುದ್ರಣ("%.6f %.6f %.6f\n", ವರ್ಗಮೂಲ(2.0), ಘನಮೂಲ(27.0), ಘಾತ(2.0, 10.0));
    ರೂಪಮುದ್ರಣ("%.6f %.6f %.6f\n", ಜ್ಯಾ(ಪೈ / 2), ಕೋಜ್ಯಾ(ಪೈ), ಸ್ಪರ್ಶಕ(ಪೈ / 4));
    ರೂಪಮುದ್ರಣ("%.6f %.6f %.6f\n", ಲಘುಗಣಕ(ನೈಜ_ಆಧಾರ), ದಶ_ಲಘುಗಣಕ(1000.0), ದ್ವಿ_ಲಘುಗಣಕ(1024.0));
    ರೂಪಮುದ್ರಣ("%.1f %.1f %.1f %.1f\n", ಕೆಳಸುತ್ತು(-2.5), ಮೇಲ್ಸುತ್ತು(-2.5), ಸುತ್ತು(2.5), ಮೊಟಕು(-2.7));
    ರೂಪಮುದ್ರಣ("%.2f %.2f %.4f\n", ದಶಾಂಶ_ಶೇಷ(10.5, 3.0), ಕರ್ಣ(3.0, 4.0), ವಿಲೋಮ_ಸ್ಪರ್ಶಕ2(1.0, 1.0));
    ಸಾಲುಮುದ್ರಿಸು(ಸ್ಥಾನಗಳಿಗೆ_ಸುತ್ತು(3.14159, 2));
    ಸಾಲುಮುದ್ರಿಸು(ಪೂರ್ಣಾಂಕ_ಘಾತ(3, 13), " ", ಮಸಾಅ(84, 36), " ", ಲಸಾಅ(21, 6), " ", ಅಪವರ್ತನೀಯ(10));
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 1; ಇ <= 30; ಇ++) (ಅವಿಭಾಜ್ಯವೇ(ಇ)) ಆದರೆ ಮುದ್ರಿಸು(ಇ, " ");
    ಸಾಲುಮುದ್ರಿಸು();
    ಸಾಲುಮುದ್ರಿಸು(ಸಂಖ್ಯೆಯಲ್ಲವೇ(ವರ್ಗಮೂಲ(-1.0)), " ", ಅನಂತವೇ(1.0 / 0.0), " ", ದಶಾಂಶ_ನಿರಪೇಕ್ಷ(-3.5));
    ಸಾಲುಮುದ್ರಿಸು(ನಿರಪೇಕ್ಷ(-7), " ", ಕನಿಷ್ಠ(3, 9), " ", ಗರಿಷ್ಠ(3, 9), " ", ದೀರ್ಘ_ಗರಿಷ್ಠ(5, -5));

    ಯಾದೃಚ್ಛಿಕ_ಬೀಜ(42);
    ಸಂಖ್ಯೆ ಸರಿ = 1;
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 0; ಇ < 1000; ಇ++) {
        ಸಂಖ್ಯೆ ಯ = ಯಾದೃಚ್ಛಿಕ_ವ್ಯಾಪ್ತಿ(1, 6);
        (ಯ < 1 || ಯ > 6) ಆದರೆ ಸರಿ = 0;
        ದಶಾಂಶ ಘ = ಯಾದೃಚ್ಛಿಕ_ದಶಾಂಶ();
        (ಘ < 0.0 || ಘ >= 1.0) ಆದರೆ ಸರಿ = 0;
    }
    ಸಾಲುಮುದ್ರಿಸು("ಯಾದೃಚ್ಛಿಕ ವ್ಯಾಪ್ತಿ ಸರಿ: ", ಸರಿ);

    ಸಂಖ್ಯೆ ಸಂ[8] = {42, 7, 19, 3, 88, 1, 56, 23};
    ಸಂಖ್ಯೆಗಳನ್ನು_ವಿಂಗಡಿಸು(ಸಂ, 8);
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 0; ಇ < 8; ಇ++) ಮುದ್ರಿಸು(ಸಂ[ಇ], " ");
    ಸಾಲುಮುದ್ರಿಸು();
    ಸಾಲುಮುದ್ರಿಸು(ದ್ವಿಮಾನ_ಹುಡುಕು(ಸಂ, 8, 56), " ", ದ್ವಿಮಾನ_ಹುಡುಕು(ಸಂ, 8, 50));
    ಸಾಲುಮುದ್ರಿಸು(ಪ್ರಸ್ತುತ_ಸಮಯ() > 1600000000);
    ಮರಳಿ 0;
}
