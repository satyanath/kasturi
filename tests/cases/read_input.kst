// ಓದು ಹೇಳಿಕೆ ಮತ್ತು ರೂಪಓದು (ಒಳಹರಿವು read_input.in ಕಡತದಿಂದ)

ಆಮದು "ಐಒ";

ಕ್ರಿಯೆ ಮುಖ್ಯ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ಸಂಖ್ಯೆ ಅ, ಬ;
    ದೀರ್ಘ ದೊ;
    ದಶಾಂಶ ದ;
    ತಾರ್ಕಿಕ ತಾ;
    ಅಕ್ಷರ ಚ;
    ಅಕ್ಷರ ಪದ_ಸ್ಥಳ[32];
    ಪದ ಹೊಸಪದ;

    ಮುದ್ರಿಸು("ಎರಡು ಸಂಖ್ಯೆಗಳು: ");
    ಓದು(ಅ, ಬ);
    ಸಾಲುಮುದ್ರಿಸು(ಅ + ಬ);
    ಓದು(ದೊ, ದ);
    ಸಾಲುಮುದ್ರಿಸು(ದೊ * 2, " ", ದ * 2);
    ಓದು(ತಾ, ಚ);
    ಸಾಲುಮುದ್ರಿಸು(ತಾ, " ", ಚ);
    ಓದು(ಪದ_ಸ್ಥಳ, ಹೊಸಪದ);
    ಸಾಲುಮುದ್ರಿಸು(ಪದ_ಸ್ಥಳ, "|", ಹೊಸಪದ);

    ಸಂಖ್ಯೆ ಗಂ, ನಿ;
    ಸಂಖ್ಯೆ ಸಿಕ್ಕ = ರೂಪಓದು("%d:%d", &ಗಂ, &ನಿ);
    ಸಾಲುಮುದ್ರಿಸು(ಸಿಕ್ಕ, " -> ", ಗಂ * 60 + ನಿ, " ನಿಮಿಷ");

    // ಉಳಿದ ಸಾಲುಗಳ ಮೊತ್ತ, ಕಡತಾಂತದವರೆಗೆ
    ಸಂಖ್ಯೆ ಮೊತ್ತ = 0, ಮೌ;
    (ರೂಪಓದು("%d", &ಮೌ) == 1) ಸಮಯವರೆಗೆ ಮೊತ್ತ += ಮೌ;
    ಸಾಲುಮುದ್ರಿಸು("ಮೊತ್ತ = ", ಮೊತ್ತ);
    ಸಾಲುಮುದ್ರಿಸು("ಕಡತಾಂತ: ", ಕಡತಾಂತವೇ(ಒಳಹರಿವು) != 0);
    ಮರಳಿ 0;
}
