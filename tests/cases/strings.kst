// ಪದಗಳು: ಹೋಲಿಕೆ, ಅಕ್ಷರಶಃಗಳು, ತಪ್ಪಿಸಿಕೊಳ್ಳುವ ಅನುಕ್ರಮಗಳು, ಪದಗಳು ಗ್ರಂಥಾಲಯ

ಆಮದು "ಪದಗಳು";
ಆಮದು "ಸಾಮಾನ್ಯ";

ಕ್ರಿಯೆ ಮುಖ್ಯ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ಪದ ಅ = "ಮಾವು";
    ಅಕ್ಷರ ಸ್ಥಳ[32] = "ಮಾವು";
    ಪದ ಬ = ಸ್ಥಳ;
    // ಪದಗಳ ಮೇಲಿನ ಹೋಲಿಕೆ ವಿಷಯವನ್ನು ಹೋಲಿಸುತ್ತದೆ, ವಿಳಾಸವನ್ನಲ್ಲ
    ಸಾಲುಮುದ್ರಿಸು(ಅ ಸಮಾನ ಬ, " ", ಅ ಸಮಾನವಲ್ಲ "ಬಾಳೆ", " ", "ಆನೆ" < "ಇಲಿ", " ", "b" > "a");

    ಸಾಲುಮುದ್ರಿಸು("ಟ್ಯಾಬ್:\tಮುಗಿದಿದೆ");
    ಸಾಲುಮುದ್ರಿಸು("ಉದ್ಧರಣ: \"ಕನ್ನಡ\" \\ ಹಿಮ್ಮುಖ");
    ಸಾಲುಮುದ್ರಿಸು("ಯುನಿಕೋಡ್: \u0C95\u0CA8\u0CCD\u0CA8\u0CA1 \x41\102");
    ಸಾಲುಮುದ್ರಿಸು("ಜೋಡಿಸಿದ " "ಅಕ್ಷರಶಃಗಳು " "ಒಂದಾಗುತ್ತವೆ");

    ಅಕ್ಷರ ಚ = 'a';
    ಸಂಖ್ಯೆ ಕ = 'ಕ';      // ಕನ್ನಡ ಅಕ್ಷರ ಅಕ್ಷರಶಃ = ಯುನಿಕೋಡ್ ಸಂಕೇತ
    ಸಾಲುಮುದ್ರಿಸು(ಚ, " ", (ಸಂಖ್ಯೆ) ಚ, " ", ಕ, " ", '\n' == 10);

    ಪದ ವಾಕ್ಯ = "ಕನ್ನಡ ನಾಡು";
    ಸಾಲುಮುದ್ರಿಸು(ಉದ್ದ(ವಾಕ್ಯ), " ", ಅಕ್ಷರಗಳ_ಸಂಖ್ಯೆ(ವಾಕ್ಯ));
    ಪದ ಉ = ಉಪಪದ(ವಾಕ್ಯ, 6, 3);
    ಸಾಲುಮುದ್ರಿಸು("[", ಉ, "]");
    ಸಾಲುಮುದ್ರಿಸು(ಸ್ಥಾನ_ಹುಡುಕು(ವಾಕ್ಯ, "ನಾಡು"), " ", ಆರಂಭವಾಗುತ್ತದೆಯೇ(ವಾಕ್ಯ, "ಕನ್ನಡ"), " ", ಕೊನೆಗೊಳ್ಳುತ್ತದೆಯೇ(ವಾಕ್ಯ, "ನಾಡ"));
    ಸಾಲುಮುದ್ರಿಸು(ಪದ_ತಿರುಗಿಸು("abc"), " ", ದೊಡ್ಡಕ್ಷರ_ಪದ("Kasturi 1"), " ", ಸಣ್ಣಕ್ಷರ_ಪದ("ABC"));
    ಸಾಲುಮುದ್ರಿಸು("[", ಪದ_ಕತ್ತರಿಸು("   ಸ್ಥಳ   "), "]");
    ಸಾಲುಮುದ್ರಿಸು(ಪದ_ಪುನರಾವರ್ತಿಸು("ಹಾ", 3), " ", ಪದ_ಬದಲಿಸು("೧-೨-೩", "-", "+"));
    ಸಾಲುಮುದ್ರಿಸು(ಅಕ್ಷರ_ಸಂಕೇತ(ವಾಕ್ಯ, 0), " ", ಕನ್ನಡವೇ(ಅಕ್ಷರ_ಸಂಕೇತ(ವಾಕ್ಯ, 0)), " ", ಅಂಕಿ_ಮೌಲ್ಯ('೭'));

    ಅಕ್ಷರ ಗುರಿ[64];
    ಪದ_ನಕಲಿಸು(ಗುರಿ, "ಹಲೋ");
    ಪದ_ಜೋಡಿಸು(ಗುರಿ, ", ");
    ಪದ_ಜೋಡಿಸು(ಗುರಿ, "ಜಗತ್ತು");
    ಸಾಲುಮುದ್ರಿಸು(ಗುರಿ, " ", ಪದ_ಹೋಲಿಸು("a", "b"), " ", ಪದ_ಹೋಲಿಸು("b", "a"), " ", ಪದ_ಹೋಲಿಸು(ಗುರಿ, ಗುರಿ));
    ಸಾಲುಮುದ್ರಿಸು(ಅಂಕಿಯೇ('7'), " ", ವರ್ಣವೇ('7'), " ", ದೊಡ್ಡಕ್ಷರಕ್ಕೆ('q'));
    ಸಾಲುಮುದ್ರಿಸು(ಪದದಿಂದ_ಸಂಖ್ಯೆ("೪೨"), " ", ಪದದಿಂದ_ದಶಾಂಶ("೩.೫"), " ", ಕನ್ನಡ_ಅಂಕಿಪದ(1947));
    ಮರಳಿ 0;
}
