// ಸರಣಿಗಳು, ಬಹು-ಆಯಾಮ ಸರಣಿಗಳು, ಸೂಚಿಗಳು, ಗಾತ್ರ

ಸ್ಥಿರ ಸಂಖ್ಯೆ ಸಾಲುಗಳು = 3;
ಸ್ಥಿರ ಸಂಖ್ಯೆ ಕಾಲಂಗಳು = 4;

ಸಂಖ್ಯೆ ಜಾಲ[ಸಾಲುಗಳು][ಕಾಲಂಗಳು];

ಕ್ರಿಯೆ ಮೊತ್ತ(ಸಂಖ್ಯೆ ಸರಣಿ[], ಸಂಖ್ಯೆ ನ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ಸಂಖ್ಯೆ ಫ = 0;
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 0; ಇ < ನ; ಇ++) ಫ += ಸರಣಿ[ಇ];
    ಮರಳಿ ಫ;
}

ಕ್ರಿಯೆ ತುಂಬು(ಸಂಖ್ಯೆ* ಪ್ರಾರಂಭ, ಸಂಖ್ಯೆ ನ, ಸಂಖ್ಯೆ ಮೌಲ್ಯ) {
    ಸಂಖ್ಯೆ* ಅಂತ್ಯ = ಪ್ರಾರಂಭ + ನ;
    (ಪ್ರಾರಂಭ < ಅಂತ್ಯ) ಸಮಯವರೆಗೆ {
        *ಪ್ರಾರಂಭ = ಮೌಲ್ಯ;
        ಪ್ರಾರಂಭ++;
    }
}

ಕ್ರಿಯೆ ಮುಖ್ಯ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ಸಂಖ್ಯೆ ಅಂಕಗಳು[] = {90, 75, 60, 85, 100};
    ಸಾಲುಮುದ್ರಿಸು("ಮೊತ್ತ: ", ಮೊತ್ತ(ಅಂಕಗಳು, 5));
    ಸಾಲುಮುದ್ರಿಸು("ಗಾತ್ರ: ", ಗಾತ್ರ(ಅಂಕಗಳು), " ", ಗಾತ್ರ(ಸಂಖ್ಯೆ), " ", ಗಾತ್ರ(ದೀರ್ಘ), " ", ಗಾತ್ರ(ಅಕ್ಷರ));

    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಸಾ = 0; ಸಾ < ಸಾಲುಗಳು; ಸಾ++)
        ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಕಾ = 0; ಕಾ < ಕಾಲಂಗಳು; ಕಾ++)
            ಜಾಲ[ಸಾ][ಕಾ] = ಸಾ * 10 + ಕಾ;
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಸಾ = 0; ಸಾ < ಸಾಲುಗಳು; ಸಾ++) {
        ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಕಾ = 0; ಕಾ < ಕಾಲಂಗಳು; ಕಾ++) ಮುದ್ರಿಸು(ಜಾಲ[ಸಾ][ಕಾ], " ");
        ಸಾಲುಮುದ್ರಿಸು();
    }

    ಸಂಖ್ಯೆ ಪಟ್ಟಿ[6];
    ತುಂಬು(ಪಟ್ಟಿ, 6, 7);
    ಪಟ್ಟಿ[2] = 0;
    ಸಂಖ್ಯೆ* ಸೂ = &ಪಟ್ಟಿ[0];
    ಸಾಲುಮುದ್ರಿಸು(*ಸೂ, " ", *(ಸೂ + 2), " ", ಸೂ[5], " ", ಮೊತ್ತ(ಪಟ್ಟಿ, 6));
    ಸಂಖ್ಯೆ** ಸೂಸೂ = &ಸೂ;
    **ಸೂಸೂ = 42;
    ಸಾಲುಮುದ್ರಿಸು(ಪಟ್ಟಿ[0]);

    // ಸ್ಥಳೀಯ ಸರಣಿಗಳು ಸೊನ್ನೆಯಿಂದ ಪ್ರಾರಂಭ
    ಸಂಖ್ಯೆ ಸೊ[4];
    ಸಾಲುಮುದ್ರಿಸು(ಸೊ[0] + ಸೊ[1] + ಸೊ[2] + ಸೊ[3]);

    // ಅಕ್ಷರ ಸರಣಿ ಮತ್ತು ಪದ
    ಅಕ್ಷರ ಸ್ಥಳ[16] = "abc";
    ಸ್ಥಳ[1] = 'X';
    ಪದ ಪ = ಸ್ಥಳ;
    ಸಾಲುಮುದ್ರಿಸು(ಪ, " ", ಸ್ಥಳ[0], " ", ಗಾತ್ರ(ಸ್ಥಳ));

    ದಶಾಂಶ ಮೌಲ್ಯಗಳು[3] = {1.5, 2.25};
    ಸಾಲುಮುದ್ರಿಸು(ಮೌಲ್ಯಗಳು[0] + ಮೌಲ್ಯಗಳು[1] + ಮೌಲ್ಯಗಳು[2]);

    ಪದ ವಾರಗಳು[] = {"ಸೋಮ", "ಮಂಗಳ", "ಬುಧ"};
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 0; ಇ < 3; ಇ++) ಮುದ್ರಿಸು(ವಾರಗಳು[ಇ], ";");
    ಸಾಲುಮುದ್ರಿಸು();

    ಸಂಖ್ಯೆ* ಶೂ = ಖಾಲಿ;
    ಸಾಲುಮುದ್ರಿಸು(ಶೂ == ಖಾಲಿ);
    ಮರಳಿ 0;
}
