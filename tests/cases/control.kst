// ನಿಯಂತ್ರಣ ಹರಿವು: ಆದರೆ, ಸಮಯವರೆಗೆ, ಮಾಡು, ಎಣಿಕೆ, ಆಯ್ಕೆ

ಕ್ರಿಯೆ ವರ್ಗೀಕರಿಸು(ಸಂಖ್ಯೆ ನ) ಫಲಿತಾಂಶ ಪದ {
    (ನ < 0) ಆದರೆ ಮರಳಿ "ಋಣ";
    ಇಲ್ಲವಾದರೆ (ನ == 0) ಆದರೆ ಮರಳಿ "ಸೊನ್ನೆ";
    ಇಲ್ಲವಾದರೆ ಮರಳಿ "ಧನ";
}

ಕ್ರಿಯೆ ದಿನ(ಸಂಖ್ಯೆ ನ) ಫಲಿತಾಂಶ ಪದ {
    ಆಯ್ಕೆ (ನ) {
        ಸಂದರ್ಭ 0: ಮರಳಿ "ಭಾನುವಾರ";
        ಸಂದರ್ಭ 1: ಮರಳಿ "ಸೋಮವಾರ";
        ಸಂದರ್ಭ 6: ಮರಳಿ "ಶನಿವಾರ";
        ಪೂರ್ವನಿಯೋಜಿತ: ಮರಳಿ "ಇತರ";
    }
}

ಕ್ರಿಯೆ ಮುಖ್ಯ() {
    ಸಾಲುಮುದ್ರಿಸು(ವರ್ಗೀಕರಿಸು(-5), " ", ವರ್ಗೀಕರಿಸು(0), " ", ವರ್ಗೀಕರಿಸು(8));

    // ಸಮಯವರೆಗೆ
    ಸಂಖ್ಯೆ ಇ = 0, ಮೊತ್ತ = 0;
    (ಇ < 10) ಸಮಯವರೆಗೆ {
        ಇ++;
        (ಇ % 2 == 0) ಆದರೆ ಮುಂದುವರಿಸು;
        ಮೊತ್ತ += ಇ;
    }
    ಸಾಲುಮುದ್ರಿಸು("ಬೆಸ ಮೊತ್ತ: ", ಮೊತ್ತ);

    // ಮಾಡು ... ಸಮಯವರೆಗೆ
    ಸಂಖ್ಯೆ ಎ = 100;
    ಮಾಡು {
        ಮುದ್ರಿಸು(ಎ, " ");
        ಎ /= 3;
    } (ಎ > 0) ಸಮಯವರೆಗೆ;
    ಸಾಲುಮುದ್ರಿಸು();

    // ಎಣಿಕೆ, ಒಳಗಿನ ಲೂಪ್ ಮತ್ತು ನಿಲ್ಲಿಸು
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಸಾ = 1; ಸಾ <= 4; ಸಾ++) {
        ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಕಾ = 1; ಕಾ <= 4; ಕಾ++) {
            (ಕಾ > ಸಾ) ಆದರೆ ನಿಲ್ಲಿಸು;
            ಮುದ್ರಿಸು(ಸಾ * ಕಾ, " ");
        }
        ಸಾಲುಮುದ್ರಿಸು();
    }

    // ಬಹು ಪ್ರಾರಂಭ / ನವೀಕರಣ
    ಸಂಖ್ಯೆ ಮೇ, ಕೆ;
    ಎಣಿಕೆ (ಮೇ = 0, ಕೆ = 10; ಮೇ < ಕೆ; ಮೇ++, ಕೆ--) ;
    ಸಾಲುಮುದ್ರಿಸು("ಸಂಧಿ: ", ಮೇ, " ", ಕೆ);

    // ಆಯ್ಕೆ: ಬೀಳುವಿಕೆ (fall-through) ಮತ್ತು ನಿಲ್ಲಿಸು
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ನ = 0; ನ < 5; ನ++) {
        ಆಯ್ಕೆ (ನ) {
            ಸಂದರ್ಭ 0:
            ಸಂದರ್ಭ 1:
                ಮುದ್ರಿಸು("ಸಣ್ಣ ");
                ನಿಲ್ಲಿಸು;
            ಸಂದರ್ಭ 2:
                ಮುದ್ರಿಸು("ಎರಡು ");
            ಸಂದರ್ಭ 3:
                ಮುದ್ರಿಸು("ಮೂರು ");
                ನಿಲ್ಲಿಸು;
            ಪೂರ್ವನಿಯೋಜಿತ:
                ಮುದ್ರಿಸು("ದೊಡ್ಡ ");
        }
    }
    ಸಾಲುಮುದ್ರಿಸು();
    ಸಾಲುಮುದ್ರಿಸು(ದಿನ(0), " ", ದಿನ(6), " ", ದಿನ(3));

    // ತ್ರಿಪದಿ ನಿರ್ವಾಹಕ
    ಸಂಖ್ಯೆ ಗ = 7;
    ಸಾಲುಮುದ್ರಿಸು(ಗ % 2 == 0 ? "ಸಮ" : "ಬೆಸ");
}
