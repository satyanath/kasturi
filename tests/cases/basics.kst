// ಮೂಲ ಪ್ರಕಾರಗಳು, ಅಂಕಗಣಿತ, ಪದ ಮತ್ತು ಚಿಹ್ನೆ ನಿರ್ವಾಹಕಗಳು

ಕ್ರಿಯೆ ಮುಖ್ಯ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ಸಂಖ್ಯೆ ಅ = 17, ಬ = 5;
    ದೀರ್ಘ ದೊಡ್ಡ = 9000000000;
    ದಶಾಂಶ ದ = 2.5;
    ಅಕ್ಷರ ಚ = 'K';
    ತಾರ್ಕಿಕ ಸ = ಸತ್ಯ;
    ಪದ ಹೆಸರು = "ಕಸ್ತೂರಿ";

    ಸಾಲುಮುದ್ರಿಸು("ಅ=", ಅ, " ಬ=", ಬ);
    ಸಾಲುಮುದ್ರಿಸು(ಅ ಸೇರಿಸು ಬ, " ", ಅ ಕಡಿತ ಬ, " ", ಅ ಗುಣಿಸು ಬ, " ", ಅ ಭಾಗಿಸು ಬ, " ", ಅ ಶೇಷ ಬ);
    ಸಾಲುಮುದ್ರಿಸು(ಅ + ಬ, " ", ಅ - ಬ, " ", ಅ * ಬ, " ", ಅ / ಬ, " ", ಅ % ಬ);
    ಸಾಲುಮುದ್ರಿಸು(-ಅ / ಬ, " ", -ಅ % ಬ);
    ಸಾಲುಮುದ್ರಿಸು(ದೊಡ್ಡ * 2);
    ಸಾಲುಮುದ್ರಿಸು(ದ * 2, " ", ದ / 4, " ", 1.0 / 3);
    ಸಾಲುಮುದ್ರಿಸು(ಅ / 2.0);
    ಸಾಲುಮುದ್ರಿಸು(ಚ, " ", ಸ, " ", ಅಲ್ಲ ಸ, " ", ಹೆಸರು);

    // ಹೋಲಿಕೆಗಳು
    ಸಾಲುಮುದ್ರಿಸು(ಅ ಹೆಚ್ಚು ಬ, " ", ಅ ಕಡಿಮೆ ಬ, " ", ಅ ಸಮಾನ 17, " ", ಅ ಸಮಾನವಲ್ಲ 17);
    ಸಾಲುಮುದ್ರಿಸು(ಅ ಹೆಚ್ಚಾಗಲಿ 17, " ", ಬ ಕಡಿಮೆಯಾಗಲಿ 4, " ", ಅ >= ಬ, " ", ಅ <= ಬ);
    ಸಾಲುಮುದ್ರಿಸು((ಅ > 10 ಮತ್ತು ಬ > 10), " ", (ಅ > 10 ಅಥವಾ ಬ > 10), " ", (ಅ > 10 && !(ಬ > 10)));

    // ನಿಗದಿ ರೂಪಗಳು
    ಅ ಗೆ 100 ನಿಗದಿ;
    ಅ += 5;
    ಅ -= 2;
    ಅ *= 3;
    ಅ /= 2;
    ಅ %= 100;
    ಸಾಲುಮುದ್ರಿಸು("ಅ = ", ಅ);
    ಅ++;
    ++ಅ;
    ಬ--;
    ಸಾಲುಮುದ್ರಿಸು(ಅ, " ", ಬ);

    // ಕನ್ನಡ ಅಂಕಿಗಳು ಮತ್ತು ವಿಶೇಷ ಅಕ್ಷರಶಃಗಳು
    ಸಂಖ್ಯೆ ಕ = ೧೨೩ + ೭;
    ಸಾಲುಮುದ್ರಿಸು(ಕ, " ", 0xFF, " ", 0b1010, " ", ೩.೫);
    ಸಾಲುಮುದ್ರಿಸು(1e3, " ", 2.5e-3);
    ಮರಳಿ 0;
}
