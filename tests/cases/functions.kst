// ಕ್ರಿಯೆಗಳು: ಪುನರಾವರ್ತನೆ, ಮುಂಚಿತ ಕರೆ, ಉಲ್ಲೇಖ (ಸೂಚಿ) ಮೂಲಕ ವರ್ಗಾವಣೆ

ಕ್ರಿಯೆ ಮುಖ್ಯ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ಸಾಲುಮುದ್ರಿಸು("5! = ", ಅಪವರ್ತನೀಯ(5));
    ಸಾಲುಮುದ್ರಿಸು("20! = ", ಅಪವರ್ತನೀಯ(20));
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 0; ಇ < 12; ಇ++) ಮುದ್ರಿಸು(ಫಿಬೊನಾಚಿ(ಇ), " ");
    ಸಾಲುಮುದ್ರಿಸು();

    ಸಂಖ್ಯೆ ಅ = 3, ಬ = 9;
    ಅದಲುಬದಲು(&ಅ, &ಬ);
    ಸಾಲುಮುದ್ರಿಸು("ಅ=", ಅ, " ಬ=", ಬ);

    ಶುಭಾಶಯ("ರಾಮ");
    ಸಾಲುಮುದ್ರಿಸು(ಹನೋಯ್(10));
    ಸಾಲುಮುದ್ರಿಸು(ಸಮವೇ(10), " ", ಸಮವೇ(7));
    ಮರಳಿ 0;
}

ಕ್ರಿಯೆ ಅಪವರ್ತನೀಯ(ಸಂಖ್ಯೆ ನ) ಫಲಿತಾಂಶ ದೀರ್ಘ {
    (ನ <= 1) ಆದರೆ ಮರಳಿ 1;
    ಮರಳಿ ನ * ಅಪವರ್ತನೀಯ(ನ - 1);
}

ಕ್ರಿಯೆ ಫಿಬೊನಾಚಿ(ಸಂಖ್ಯೆ ನ) ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    (ನ < 2) ಆದರೆ ಮರಳಿ ನ;
    ಮರಳಿ ಫಿಬೊನಾಚಿ(ನ - 1) + ಫಿಬೊನಾಚಿ(ನ - 2);
}

ಕ್ರಿಯೆ ಅದಲುಬದಲು(ಸಂಖ್ಯೆ* ಕ, ಸಂಖ್ಯೆ* ಖ) {
    ಸಂಖ್ಯೆ ತಾ = *ಕ;
    *ಕ = *ಖ;
    *ಖ = ತಾ;
}

ಕ್ರಿಯೆ ಶುಭಾಶಯ(ಪದ ಹೆಸರು) {
    ಸಾಲುಮುದ್ರಿಸು("ನಮಸ್ಕಾರ, ", ಹೆಸರು, "!");
}

ಕ್ರಿಯೆ ಹನೋಯ್(ಸಂಖ್ಯೆ ತಟ್ಟೆಗಳು) ಫಲಿತಾಂಶ ದೀರ್ಘ {
    (ತಟ್ಟೆಗಳು == 0) ಆದರೆ ಮರಳಿ 0;
    ಮರಳಿ 2 * ಹನೋಯ್(ತಟ್ಟೆಗಳು - 1) + 1;
}

// ಪರಸ್ಪರ ಪುನರಾವರ್ತನೆ
ಕ್ರಿಯೆ ಸಮವೇ(ಸಂಖ್ಯೆ ನ) ಫಲಿತಾಂಶ ತಾರ್ಕಿಕ {
    (ನ == 0) ಆದರೆ ಮರಳಿ ಸತ್ಯ;
    ಮರಳಿ ಬೆಸವೇ(ನ - 1);
}

ಕ್ರಿಯೆ ಬೆಸವೇ(ಸಂಖ್ಯೆ ನ) ಫಲಿತಾಂಶ ತಾರ್ಕಿಕ {
    (ನ == 0) ಆದರೆ ಮರಳಿ ಅಸತ್ಯ;
    ಮರಳಿ ಸಮವೇ(ನ - 1);
}
