// ಬದಲಾಗುವ ಸಂಖ್ಯೆಯ ಚರಾಂಶಗಳು (variadic)

ಆಮದು "ಐಒ";

ಕ್ರಿಯೆ ಮೊತ್ತ(ಸಂಖ್ಯೆ ಎಷ್ಟು, ...) ಫಲಿತಾಂಶ ದೀರ್ಘ {
    ಚರಪಟ್ಟಿ ಪಟ್ಟಿ;
    ಚರ_ಆರಂಭ(ಪಟ್ಟಿ);
    ದೀರ್ಘ ಫ = 0;
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 0; ಇ < ಎಷ್ಟು; ಇ++) ಫ += ಚರ_ಮೌಲ್ಯ(ಪಟ್ಟಿ, ಸಂಖ್ಯೆ);
    ಚರ_ಅಂತ್ಯ(ಪಟ್ಟಿ);
    ಮರಳಿ ಫ;
}

ಕ್ರಿಯೆ ಸರಾಸರಿ(ಸಂಖ್ಯೆ ಎಷ್ಟು, ...) ಫಲಿತಾಂಶ ದಶಾಂಶ {
    ಚರಪಟ್ಟಿ ಪ;
    ಚರ_ಆರಂಭ(ಪ);
    ದಶಾಂಶ ಫ = 0;
    ಎಣಿಕೆ (ಸಂಖ್ಯೆ ಇ = 0; ಇ < ಎಷ್ಟು; ಇ++) ಫ += ಚರ_ಮೌಲ್ಯ(ಪ, ದಶಾಂಶ);
    ಚರ_ಅಂತ್ಯ(ಪ);
    ಮರಳಿ ಫ / ಎಷ್ಟು;
}

// ತನ್ನದೇ ಆದ printf ತರಹದ ಕ್ರಿಯೆ
ಕ್ರಿಯೆ ದಾಖಲೆ(ಪದ ಮಟ್ಟ, ಪದ ರೂಪ, ...) {
    ಚರಪಟ್ಟಿ ಪ, ನಕಲು;
    ಚರ_ಆರಂಭ(ಪ);
    ಚರ_ನಕಲು(ನಕಲು, ಪ);
    ರೂಪಮುದ್ರಣ("[%s] ", ಮಟ್ಟ);
    ಪಟ್ಟಿ_ರೂಪಮುದ್ರಣ(ರೂಪ, ಪ);
    ಪದ ಎರಡನೇ = ಪಟ್ಟಿ_ಪದರೂಪಿಸು(ರೂಪ, ನಕಲು);
    ರೂಪಮುದ್ರಣ(" | %s\n", ಎರಡನೇ);
    ಚರ_ಅಂತ್ಯ(ನಕಲು);
    ಚರ_ಅಂತ್ಯ(ಪ);
}

ಕ್ರಿಯೆ ಮುಖ್ಯ() ಫಲಿತಾಂಶ ಸಂಖ್ಯೆ {
    ಸಾಲುಮುದ್ರಿಸು(ಮೊತ್ತ(4, 10, 20, 30, 40));
    ಸಾಲುಮುದ್ರಿಸು(ಮೊತ್ತ(0));
    ಸಾಲುಮುದ್ರಿಸು(ಸರಾಸರಿ(3, 1.0, 2.0, 4.5));
    ದಾಖಲೆ("ಮಾಹಿತಿ", "%d + %d = %d", 2, 3, 5);
    ದಾಖಲೆ("ಎಚ್ಚರಿಕೆ", "%s ಕಡತ %.1f%% ತುಂಬಿದೆ", "ದತ್ತಾಂಶ", 99.5);
    ಮರಳಿ 0;
}
